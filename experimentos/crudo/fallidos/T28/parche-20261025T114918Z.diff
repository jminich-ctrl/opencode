+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.datos.search_ads import buscar_anuncios
+from backend.app.servicios.search import buscar_anuncios_servicio
+
+
+class TestSearchBackend:
+    """Tests para la funcionalidad de búsqueda de anuncios."""
+
+    def test_buscar_anuncios_datos_sin_categoria(self):
+        """Test de búsqueda en datos sin categoría."""
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            mock_conn = MagicMock()
+            mock_cur = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_value.__enter__.return_value = mock_cur
+            
+            # Configurar el mock para devolver resultados
+            mock_cur.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio 1',
+                    'descripcion': 'Descripción 1',
+                    'categoria_id': 1
+                },
+                {
+                    'id': 2,
+                    'titulo': 'Anuncio 2',
+                    'descripcion': 'Descripción 2',
+                    'categoria_id': 1
+                }
+            ]
+            
+            # Llamar a la función
+            resultado = buscar_anuncios("texto", None)
+            
+            # Verificar que se llamó a execute con los parámetros correctos
+            mock_cur.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s",
+                ("%texto%", "%texto%")
+            )
+            
+            # Verificar resultado
+            assert len(resultado) == 2
+            assert resultado[0]['titulo'] == 'Anuncio 1'
+            assert resultado[1]['titulo'] == 'Anuncio 2'
+            # Verificar que los campos esperados estén presentes
+            assert 'id' in resultado[0]
+            assert 'titulo' in resultado[0]
+            assert 'descripcion' in resultado[0]
+            assert 'categoria_id' in resultado[0]
+
+    def test_buscar_anuncios_datos_con_categoria(self):
+        """Test de búsqueda en datos con categoría."""
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            mock_conn = MagicMock()
+            mock_cur = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_return_value = mock_cur
+            
+            # Configurar el mock para devolver resultados
+            mock_cur.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio 1',
+                    'descripcion': 'Descripción 1',
+                    'categoria_id': 1
+                }
+            ]
+            
+            # Llamar a la función
+            resultado = buscar_anuncios("texto", "1")
+            
+            # Verificar que se llamó a execute con los parámetros correctos
+            mock_cur.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s AND categoria_id = %s",
+                ("%texto%", "%texto%", "1")
+            )
+            
+            # Verificar resultado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio 1'
+            # Verificar que los campos esperados estén presentes
+            assert 'id' in resultado[0]
+            assert 'titulo' in resultado[0]
+            assert 'descripcion' in resultado[0]
+            assert 'categoria_id' in resultado[0]
+
+    def test_buscar_anuncios_servicio(self):
+        """Test de búsqueda en servicio."""
+        with patch('backend.app.datos.search_ads.buscar_anuncios') as mock_buscar:
+            mock_buscar.return_value = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio 1',
+                    'descripcion': 'Descripción 1',
+                    'categoria_id': 1
+                },
+                {
+                    'id': 2,
+                    'titulo': 'Anuncio 2',
+                    'descripcion': 'Descripción 2',
+                    'categoria_id': 1
+                }
+            ]
+            
+            resultado = buscar_anuncios_servicio("texto", None)
+            
+            assert len(resultado) == 2
+            assert resultado[0]['titulo'] == 'Anuncio 1'
+            assert resultado[1]['titulo'] == 'Anuncio 2'
+            # Verificar que los campos esperados estén presentes
+            assert 'id' in resultado[0]
+            assert 'titulo' in resultado[0]
+            assert 'descripcion' in resultado[0]
+            assert 'categoria_id' in resultado[0]
