+"""
+Datos de búsqueda de anuncios.
+"""
+
+from backend.app.datos.conexion import conexion
+
+
+def buscar_anuncios(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Busca anuncios por texto y categoría.
+    
+    Args:
+        texto: Texto a buscar en los anuncios
+        categoria: ID de categoría opcional
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            # Construimos la consulta dinámica
+            query = "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s"
+            params = [f"%{texto}%", f"%{texto}%"]
+            
+            # Si se especifica categoría, añadimos el filtro
+            if categoria is not None:
+                query += " AND categoria_id = %s"
+                params.append(categoria)
+                
+            cur.execute(query, params)
+            resultados = cur.fetchall()
+            
+            # Convertimos a lista de diccionarios
+            anuncios = []
+            for fila in resultados:
+                anuncio = {
+                    'id': fila['id'],
+                    'titulo': fila['titulo'],
+                    'descripcion': fila['descripcion'],
+                    'categoria_id': fila['categoria_id']
+                }
+                anuncios.append(anuncio)
+                
+            return anuncios
