+"""
+Ruta de búsqueda de anuncios.
+"""
+
+from fastapi import APIRouter, Depends, HTTPException
+from typing import Optional
+
+from backend.app.servicios.search import buscar_anuncios_servicio
+
+
+router = APIRouter(tags=["search"])
+
+
+@router.get("/search")
+def buscar_anuncios_ruta(q: str, category: Optional[str] = None):
+    """
+    Busca anuncios por texto libre y categoría.
+    
+    Args:
+        q: Texto a buscar
+        category: ID de categoría opcional
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios
+    """
+    try:
+        anuncios = buscar_anuncios_servicio(q, category)
+        return anuncios
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error en la búsqueda")
