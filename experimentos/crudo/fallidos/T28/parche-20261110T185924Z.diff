+"""
+Acceso a datos para búsquedas de anuncios.
+"""
+
+from backend.app.datos.conexion import conexion
+
+def buscar_anuncios_db(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Busca anuncios por texto y categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: Nombre de la categoría a filtrar (opcional)
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is None:
+                # Búsqueda solo por texto
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, usuario_id, categoria_id, creado_en
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY creado_en DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            else:
+                # Búsqueda por texto y categoría
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, usuario_id, categoria_id, creado_en
+                    FROM anuncios 
+                    WHERE (titulo LIKE %s OR descripcion LIKE %s) AND categoria_id = (
+                        SELECT id FROM categorias WHERE nombre = %s
+                    )
+                    ORDER BY creado_en DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            
+            return cur.fetchall()
