+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi import HTTPException
+from backend.app.servicios.search import buscar_anuncios
+
+# Test para el servicio de búsqueda
+class TestSearchBackend:
+    
+    def test_buscar_anuncios_sin_categoria(self):
+        """Prueba búsqueda de anuncios por texto sin filtro de categoría"""
+        # Mock de la función de datos
+        with patch('backend.app.servicios.search.buscar_anuncios_db') as mock_buscar:
+            # Configurar el mock para devolver resultados
+            mock_result = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción del anuncio',
+                    'precio_centavos': 1000,
+                    'usuario_id': 1,
+                    'categoria_id': 1,
+                    'creado_en': '2023-01-01'
+                }
+            ]
+            mock_buscar.return_value = mock_result
+            
+            # Llamar al servicio
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificar que se llamó a la función de datos con los parámetros correctos
+            mock_buscar.assert_called_once_with("prueba", None)
+            
+            # Verificar que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_con_categoria(self):
+        """Prueba búsqueda de anuncios por texto y categoría"""
+        # Mock de la función de datos
+        with patch('backend.app.servicios.search.buscar_anuncios_db') as mock_buscar:
+            # Configurar el mock para devolver resultados
+            mock_result = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción del anuncio',
+                    'precio_centavos': 1000,
+                    'usuario_id': 1,
+                    'categoria_id': 1,
+                    'creado_en': '2023-01-01'
+                }
+            ]
+            mock_buscar.return_value = mock_result
+            
+            # Llamar al servicio
+            resultado = buscar_anuncios("prueba", "Electrónica")
+            
+            # Verificar que se llamó a la función de datos con los parámetros correctos
+            mock_buscar.assert_called_once_with("prueba", "Electrónica")
+            
+            # Verificar que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_sin_resultados(self):
+        """Prueba búsqueda de anuncios sin resultados"""
+        # Mock de la función de datos
+        with patch('backend.app.servicios.search.buscar_anuncios_db') as mock_buscar:
+            # Configurar el mock para devolver resultados vacíos
+            mock_buscar.return_value = []
+            
+            # Llamar al servicio
+            resultado = buscar_anuncios("prueba", "Electrónica")
+            
+            # Verificar que se llamó a la función de datos con los parámetros correctos
+            mock_buscar.assert_called_once_with("prueba", "Electrónica")
+            
+            # Verificar que el resultado es una lista vacía
+            assert resultado == []
