+from backend.app.datos.conexion import conexion
+
+def obtener_anuncios_por_texto_y_categoria(texto: str, categoria: str | None = None) -> list[dict]:
+    """Obtiene anuncios que coinciden con el texto y, opcionalmente, la categoría."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is not None:
+                cur.execute(
+                    "SELECT id, titulo, descripcion FROM anuncios WHERE titulo LIKE %s AND categoria_id = %s",
+                    (f"%{texto}%", categoria)
+                )
+            else:
+                cur.execute(
+                    "SELECT id, titulo, descripcion FROM anuncios WHERE titulo LIKE %s",
+                    (f"%{texto}%",)
+                )
+            return cur.fetchall()
