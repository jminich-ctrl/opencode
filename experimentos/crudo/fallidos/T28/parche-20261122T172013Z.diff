+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.servicios.search import buscar_anuncios
+from backend.app.datos.search_ads import obtener_anuncios_por_texto_y_categoria
+
+
+class TestSearchBackend:
+    
+    def test_buscar_anuncios_sin_filtro(self):
+        """Prueba búsqueda sin filtro de categoría"""
+        # Datos de prueba
+        texto = "laptop"
+        mock_result = [
+            {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"},
+            {"id": 2, "titulo": "Laptop de escritorio", "descripcion": "Laptop para oficina"}
+        ]
+        
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock:
+            mock.return_value = mock_result
+            resultado = buscar_anuncios(texto)
+            
+            assert resultado == mock_result
+            mock.assert_called_once_with(texto, None)
+    
+    def test_buscar_anuncios_con_filtro(self):
+        """Prueba búsqueda con filtro de categoría"""
+        # Datos de prueba
+        texto = "laptop"
+        categoria = "electronica"
+        mock_result = [
+            {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"}
+        ]
+        
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock:
+            mock.return_value = mock_result
+            resultado = buscar_anuncios(texto, categoria)
+            
+            assert resultado == mock_result
+            mock.assert_called_once_with(texto, categoria)
+    
+    def test_buscar_anuncios_sin_resultados(self):
+        """Prueba búsqueda sin resultados"""
+        texto = "laptop"
+        mock_result = []
+        
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock:
+            mock.return_value = mock_result
+            resultado = buscar_anuncios(texto)
+            
+            assert resultado == mock_result
+            mock.assert_called_once_with(texto, None)
+    
+    def test_obtener_anuncios_por_texto_y_categoria(self):
+        """Prueba acceso a datos de búsqueda"""
+        # Datos de prueba
+        texto = "laptop"
+        categoria = "electronica"
+        mock_result = [
+            {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"}
+        ]
+        
+        # Simular conexión a base de datos
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value.cursor.return_value = mock_cursor
+            mock_cursor.fetchall.return_value = [
+                {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"}
+            ]
+            
+            resultado = obtener_anuncios_por_texto_y_categoria(texto, categoria)
+            
+            assert resultado == mock_result
+            mock_cursor.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion FROM anuncios WHERE titulo LIKE %s AND categoria_id = %s",
+                (f"%{texto}%", categoria)
+            )
+    
+    def test_obtener_anuncios_por_texto_y_categoria_sin_categoria(self):
+        """Prueba acceso a datos de búsqueda sin filtro de categoría"""
+        # Datos de prueba
+        texto = "laptop"
+        mock_result = [
+            {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"}
+        ]
+        
+        # Simular conexión a base de datos
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value.cursor.return_value = mock_cursor
+            mock_cursor.fetchall.return_value = [
+                {"id": 1, "titulo": "Laptop gaming", "descripcion": "Laptop de alto rendimiento"}
+            ]
+            
+            resultado = obtener_anuncios_por_texto_y_categoria(texto, None)
+            
+            assert resultado == mock_result
+            mock_cursor.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion FROM anuncios WHERE titulo LIKE %s",
+                (f"%{texto}%",)
+            )
