+from .conexion import conexion
+
+def buscar_anuncios(texto: str, categoria: str | None = None) -> list[dict]:
+    """Busca anuncios que coincidan con el texto y, opcionalmente, la categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: Categoría opcional para filtrar los resultados
+        
+    Returns:
+        list[dict]: Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is not None:
+                # Buscar anuncios por texto y categoría
+                cur.execute("""
+                    SELECT id, usuario_id, categoria_id, titulo, descripcion, precio_centavos
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    AND categoria_id = (
+                        SELECT id FROM categorias WHERE nombre = %s
+                    )
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            else:
+                # Buscar anuncios solo por texto
+                cur.execute("""
+                    SELECT id, usuario_id, categoria_id, titulo, descripcion, precio_centavos
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            
+            return cur.fetchall()
