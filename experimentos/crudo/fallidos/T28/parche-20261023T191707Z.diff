+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.datos.search_ads import buscar_anuncios
+from backend.app.servicios.search import buscar_anuncios_servicio
+
+class TestSearchBackend:
+    """Tests para la funcionalidad de búsqueda de anuncios."""
+    
+    def test_buscar_anuncios_sin_categoria(self):
+        """Prueba búsqueda de anuncios sin filtro por categoría."""
+        # Mockeamos la conexión a la base de datos
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            # Configuramos el mock para simular una conexión exitosa
+            mock_conn = MagicMock()
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_value = mock_cursor
+            
+            # Simulamos resultados de la consulta
+            mock_cursor.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 1,
+                    'categoria_id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio_centavos': 1000
+                }
+            ]
+            
+            # Ejecutamos la función
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificamos que se haya llamado a execute con los parámetros correctos
+            expected_query = "SELECT id, usuario_id, categoria_id, titulo, descripcion, precio_centavos FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s ORDER BY id DESC"
+            mock_cursor.execute.assert_called_once_with(expected_query, ("%prueba%", "%prueba%"))
+            
+            # Verificamos que se haya devuelto el resultado esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_con_categoria(self):
+        """Prueba búsqueda de anuncios con filtro por categoría."""
+        # Mockeamos la conexión a la base de datos
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            # Configuramos el mock para simular una conexión exitosa
+            mock_conn = MagicMock()
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_value = mock_cursor
+            
+            # Simulamos resultados de la consulta
+            mock_cursor.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 1,
+                    'categoria_id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio_centavos': 1000
+                }
+            ]
+            
+            # Ejecutamos la función
+            resultado = buscar_anuncios("prueba", "Electrónica")
+            
+            # Verificamos que se haya llamado a execute con los parámetros correctos
+            expected_query = "SELECT id, usuario_id, categoria_id, titulo, descripcion, precio_centavos FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s AND categoria_id = (SELECT id FROM categorias WHERE nombre = %s) ORDER BY id DESC"
+            mock_cursor.execute.assert_called_once_with(expected_query, ("%prueba%", "%prueba%", "Electrónica"))
+            
+            # Verificamos que se haya devuelto el resultado esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_servicio(self):
+        """Prueba el servicio de búsqueda de anuncios."""
+        # Mockeamos la función de datos
+        with patch('backend.app.servicios.search.buscar_anuncios') as mock_buscar:
+            # Configuramos el mock para simular resultados
+            mock_buscar.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 1,
+                    'categoria_id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio_centavos': 1000
+                }
+            ]
+            
+            # Ejecutamos el servicio
+            resultado = buscar_anuncios_servicio("prueba", "Electrónica")
+            
+            # Verificamos que se haya llamado a la función de datos con los parámetros correctos
+            mock_buscar.assert_called_once_with("prueba", "Electrónica")
+            
+            # Verificamos que se haya devuelto el resultado esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
