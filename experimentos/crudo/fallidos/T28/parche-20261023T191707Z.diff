+from fastapi import APIRouter, Depends, HTTPException
+from typing import List
+from ..servicios.search import buscar_anuncios_servicio
+
+router = APIRouter(prefix="/search", tags=["search"])
+
+@router.get("/", response_model=List[dict])
+async def search(q: str, category: str = None):
+    """
+    Busca anuncios por texto libre y/o categoría.
+    
+    Args:
+        q: Texto a buscar en los campos de los anuncios
+        category: Categoría opcional para filtrar los resultados
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    try:
+        resultados = buscar_anuncios_servicio(q, category)
+        return resultados
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error interno del servidor")
