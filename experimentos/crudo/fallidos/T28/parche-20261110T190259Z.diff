+"""
+Datos de búsqueda de anuncios.
+"""
+
+from backend.app.datos.conexion import conexion
+
+
+def buscar_anuncios(texto: str, categoria: str | None = None) -> list[dict]:
+    """Devuelve anuncios que coinciden con el texto y, opcionalmente, la categoría."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is None:
+                # Búsqueda por texto solo
+                cur.execute("""
+                    SELECT id, usuario_id, titulo, descripcion, precio_centavos, categoria_id, creado_en
+                    FROM anuncios
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY creado_en DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            else:
+                # Búsqueda por texto y categoría
+                cur.execute("""
+                    SELECT id, usuario_id, titulo, descripcion, precio_centavos, categoria_id, creado_en
+                    FROM anuncios
+                    WHERE (titulo LIKE %s OR descripcion LIKE %s)
+                    AND categoria_id = %s
+                    ORDER BY creado_en DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            
+            resultados = []
+            for row in cur.fetchall():
+                resultados.append({
+                    'id': row['id'],
+                    'usuario_id': row['usuario_id'],
+                    'titulo': row['titulo'],
+                    'descripcion': row['descripcion'],
+                    'precio': row['precio_centavos'],
+                    'categoria_id': row['categoria_id'],
+                    'fecha_creacion': row['creado_en']
+                })
+            
+            return resultados
