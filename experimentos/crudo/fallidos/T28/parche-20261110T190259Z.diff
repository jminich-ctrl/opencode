+"""
+Ruta de búsqueda de anuncios.
+"""
+
+from fastapi import APIRouter, HTTPException, Query
+from typing import Optional
+from backend.app.servicios.search import buscar_anuncios_servicio
+
+router = APIRouter()
+
+
+@router.get("/search")
+def search(
+    q: str = Query(..., description="Texto a buscar"),
+    category: Optional[str] = Query(None, description="Filtrar por categoría")
+):
+    """Búsqueda de anuncios por texto y categoría."""
+    try:
+        resultados = buscar_anuncios_servicio(q, category)
+        return {"anuncios": resultados}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error en la búsqueda: {str(e)}")
