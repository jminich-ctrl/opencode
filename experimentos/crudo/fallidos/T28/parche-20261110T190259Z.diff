+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.datos.search_ads import buscar_anuncios
+from backend.app.servicios.search import buscar_anuncios_servicio
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+class TestSearchBackend:
+    """Tests para la funcionalidad de búsqueda de anuncios."""
+
+    def test_buscar_anuncios_sin_categoria(self):
+        """Prueba búsqueda de anuncios sin filtro por categoría."""
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value.cursor.return_value = mock_cursor
+            
+            # Configurar el resultado de la consulta
+            mock_cursor.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 123,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio': 1000,
+                    'categoria_id': 1,
+                    'fecha_creacion': '2023-01-01'
+                }
+            ]
+            
+            # Ejecutar la función
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificaciones
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+            mock_cursor.execute.assert_called_once_with(
+                """
+                    SELECT id, usuario_id, titulo, descripcion, precio_centavos, categoria_id, creado_en
+                    FROM anuncios
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY creado_en DESC
+                """,
+                ('%prueba%', '%prueba%')
+            )
+
+    def test_buscar_anuncios_con_categoria(self):
+        """Prueba búsqueda de anuncios con filtro por categoría."""
+        with patch('backend.app.datos.search_ads.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conexion.return_value.__enter__.return_value.cursor.return_value = mock_cursor
+            
+            # Configurar el resultado de la consulta
+            mock_cursor.fetchall.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 123,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio': 1000,
+                    'categoria_id': 1,
+                    'fecha_creacion': '2023-01-01'
+                }
+            ]
+            
+            # Ejecutar la función
+            resultado = buscar_anuncios("prueba", "1")
+            
+            # Verificaciones
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+            mock_cursor.execute.assert_called_once_with(
+                """
+                    SELECT id, usuario_id, titulo, descripcion, precio_centavos, categoria_id, creado_en
+                    FROM anuncios
+                    WHERE (titulo LIKE %s OR descripcion LIKE %s)
+                    AND categoria_id = %s
+                    ORDER BY creado_en DESC
+                """,
+                ('%prueba%', '%prueba%', '1')
+            )
+
+    def test_buscar_anuncios_servicio(self):
+        """Prueba el servicio de búsqueda de anuncios."""
+        with patch('backend.app.datos.search_ads.buscar_anuncios') as mock_buscar:
+            mock_buscar.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 123,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio': 1000,
+                    'categoria_id': 1,
+                    'fecha_creacion': '2023-01-01'
+                }
+            ]
+            
+            resultado = buscar_anuncios_servicio("prueba", "1")
+            
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+            mock_buscar.assert_called_once_with("prueba", "1")
+
+    def test_ruta_search_sin_categoria(self):
+        """Prueba la ruta de búsqueda sin categoría."""
+        with patch('backend.app.servicios.search.buscar_anuncios_servicio') as mock_buscar:
+            mock_buscar.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 123,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio': 1000,
+                    'categoria_id': 1,
+                    'fecha_creacion': '2023-01-01'
+                }
+            ]
+            
+            # Simular llamada a la ruta
+            client = TestClient(app)
+            response = client.get("/search", params={'q': 'prueba'})
+            
+            assert response.status_code == 200
+            assert "anuncios" in response.json()
+            mock_buscar.assert_called_once_with('prueba', None)
+
+    def test_ruta_search_con_categoria(self):
+        """Prueba la ruta de búsqueda con categoría."""
+        with patch('backend.app.servicios.search.buscar_anuncios_servicio') as mock_buscar:
+            mock_buscar.return_value = [
+                {
+                    'id': 1,
+                    'usuario_id': 123,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio': 1000,
+                    'categoria_id': 1,
+                    'fecha_creacion': '2023-01-01'
+                }
+            ]
+            
+            # Simular llamada a la ruta
+            client = TestClient(app)
+            response = client.get("/search", params={'q': 'prueba', 'category': '1'})
+            
+            assert response.status_code == 200
+            assert "anuncios" in response.json()
+            mock_buscar.assert_called_once_with('prueba', '1')
