+"""
+Ruta de búsqueda de anuncios.
+"""
+
+from fastapi import APIRouter, Depends, HTTPException
+from typing import Optional
+
+from backend.app.servicios.search import buscar_anuncios as servicio_buscar_anuncios
+
+router = APIRouter()
+
+
+@router.get("/search")
+async def search(
+    q: str,
+    category: Optional[str] = None
+):
+    """
+    Busca anuncios por texto libre y/o categoría.
+    
+    Args:
+        q: Texto a buscar
+        category: Categoría opcional para filtrar
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios
+    """
+    try:
+        anuncios = servicio_buscar_anuncios(q, category)
+        return {"anuncios": anuncios}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error en la búsqueda: {str(e)}")
