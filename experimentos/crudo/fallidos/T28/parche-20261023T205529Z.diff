+"""
+Datos de búsqueda de anuncios.
+"""
+
+from backend.app.datos.conexion import conexion
+
+
+def search_ads(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Busca anuncios que coincidan con el texto y, opcionalmente, la categoría.
+    
+    Args:
+        texto: Texto a buscar en los anuncios
+        categoria: Categoría opcional para filtrar
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            # Construimos la consulta dinámica
+            if categoria is not None:
+                cur.execute("""
+                    SELECT id, usuario_id, titulo, descripcion, precio, categoria, fecha_creacion 
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s 
+                    AND categoria = %s
+                    ORDER BY fecha_creacion DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            else:
+                cur.execute("""
+                    SELECT id, usuario_id, titulo, descripcion, precio, categoria, fecha_creacion 
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s 
+                    ORDER BY fecha_creacion DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            
+            return cur.fetchall()
