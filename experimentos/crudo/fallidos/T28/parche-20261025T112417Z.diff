+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi import HTTPException
+from backend.app.servicios.search import buscar_anuncios
+from backend.app.datos.search_ads import buscar_anuncios_db
+
+
+class TestSearchBackend:
+    
+    def test_buscar_anuncios_sin_filtro(self):
+        """Prueba búsqueda sin filtro por categoría"""
+        # Mock de la capa de datos
+        with patch('backend.app.datos.search_ads.buscar_anuncios_db') as mock_buscar:
+            mock_result = [
+                {"id": 1, "titulo": "Anuncio 1", "descripcion": "Descripción 1", "categoria_id": 1},
+                {"id": 2, "titulo": "Anuncio 2", "descripcion": "Descripción 2", "categoria_id": 2}
+            ]
+            mock_buscar.return_value = mock_result
+            
+            # Llamada al servicio
+            resultado = buscar_anuncios("texto")
+            
+            # Verificaciones
+            assert resultado == mock_result
+            mock_buscar.assert_called_once_with("texto", None)
+    
+    def test_buscar_anuncios_con_filtro(self):
+        """Prueba búsqueda con filtro por categoría"""
+        # Mock de la capa de datos
+        with patch('backend.app.datos.search_ads.buscar_anuncios_db') as mock_buscar:
+            mock_result = [
+                {"id": 1, "titulo": "Anuncio 1", "descripcion": "Descripción 1", "categoria_id": 1},
+                {"id": 2, "titulo": "Anuncio 2", "descripcion": "Descripción 2", "categoria_id": 1}
+            ]
+            mock_buscar.return_value = mock_result
+            
+            # Llamada al servicio
+            resultado = buscar_anuncios("texto", "categoria1")
+            
+            # Verificaciones
+            assert resultado == mock_result
+            mock_buscar.assert_called_once_with("texto", "categoria1")
+    
+    def test_buscar_anuncios_db_sin_resultados(self):
+        """Prueba búsqueda en base de datos sin resultados"""
+        # Mock de la conexión a base de datos
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conn_instance = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn_instance
+            mock_conn_instance.cursor.return_value = mock_cursor
+            mock_cursor.fetchall.return_value = []
+            
+            # Llamada a la función de datos
+            resultado = buscar_anuncios_db("texto", None)
+            
+            # Verificaciones
+            assert resultado == []
+            mock_cursor.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s",
+                ("%texto%", "%texto%")
+            )
+    
+    def test_buscar_anuncios_db_con_resultados(self):
+        """Prueba búsqueda en base de datos con resultados"""
+        # Mock de la conexión a base de datos
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conn_instance = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn_instance
+            mock_conn_instance.cursor.return_value = mock_cursor
+            mock_cursor.fetchall.return_value = [
+                {"id": 1, "titulo": "Anuncio 1", "descripcion": "Descripción 1", "categoria_id": 1},
+                {"id": 2, "titulo": "Anuncio 2", "descripcion": "Descripción 2", "categoria_id": 1}
+            ]
+            
+            # Llamada a la función de datos
+            resultado = buscar_anuncios_db("texto", None)
+            
+            # Verificaciones
+            assert len(resultado) == 2
+            assert resultado[0]["titulo"] == "Anuncio 1"
+            assert resultado[1]["titulo"] == "Anuncio 2"
+            mock_cursor.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE titulo LIKE %s OR descripcion LIKE %s",
+                ("%texto%", "%texto%")
+            )
+    
+    def test_buscar_anuncios_db_con_filtro(self):
+        """Prueba búsqueda en base de datos con filtro por categoría"""
+        # Mock de la conexión a base de datos
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_cursor = MagicMock()
+            mock_conn_instance = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn_instance
+            mock_conn_instance.cursor.return_value = mock_cursor
+            mock_cursor.fetchall.return_value = [
+                {"id": 1,  "titulo": "Anuncio 1", "descripcion": "Descripción 1", "categoria_id": 1},
+                {"id": 2, "titulo": "Anuncio 2", "descripcion": "Descripción 2", "categoria_id": 1}
+            ]
+            
+            # Llamada a la función de datos
+            resultado = buscar_anuncios_db("texto", "categoria1")
+            
+            # Verificaciones
+            assert len(resultado) == 2
+            assert resultado[0]["titulo"] == "Anuncio 1"
+            assert resultado[1]["titulo"] == "Anuncio 2"
+            mock_cursor.execute.assert_called_once_with(
+                "SELECT id, titulo, descripcion, categoria_id FROM anuncios WHERE (titulo LIKE %s OR descripcion LIKE %s) AND categoria_id = %s",
+                ("%texto%", "%texto%", "categoria1")
+            )
