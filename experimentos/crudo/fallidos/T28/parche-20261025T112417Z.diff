+from backend.app.datos.conexion import conexion
+
+def buscar_anuncios_db(texto: str, categoria: str | None = None) -> list[dict]:
+    """Busca anuncios por texto libre y opcionalmente por categoría.
+    
+    Args:
+        texto: Texto a buscar en título o descripción
+        categoria: ID de categoría opcional
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is None:
+                # Búsqueda sin filtro por categoría
+                cur.execute("""
+                    SELECT id, titulo, descripcion, categoria_id 
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                """, (f"%{texto}%", f"%{texto}%"))
+            else:
+                # Búsqueda con filtro por categoría
+                cur.execute("""
+                    SELECT id, titulo, descripcion, categoria_id 
+                    FROM anuncios 
+                    WHERE (titulo LIKE %s OR descripcion LIKE %s) AND categoria_id = %s
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            
+            return cur.fetchall()
