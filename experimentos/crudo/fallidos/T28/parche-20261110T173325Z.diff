+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi import HTTPException
+from backend.app.servicios.search import buscar_anuncios
+from backend.app.datos.search_ads import obtener_anuncios_por_texto_y_categoria
+from backend.app.rutas.search import router
+
+# Test para el servicio de búsqueda
+class TestSearchBackend:
+    
+    def test_buscar_anuncios_sin_categoria(self):
+        """Prueba búsqueda de anuncios por texto sin filtro de categoría"""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock_obtener:
+            # Configuramos el mock para devolver resultados
+            mock_obtener.return_value = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio_centavos': 1000,
+                    'categoria_id': 1,
+                    'usuario_id': 1
+                }
+            ]
+            
+            # Llamamos a la función del servicio
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", None)
+            
+            # Verificamos que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_con_categoria(self):
+        """Prueba búsqueda de anuncios por texto y categoría"""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock_obtener:
+            # Configuramos el mock para devolver resultados
+            mock_obtener.return_value = [
+                {
+                    'id': 1,
+                    'titulo': 'Anuncio de prueba',
+                    'descripcion': 'Descripción de prueba',
+                    'precio_centavos': 1000,
+                    'categoria_id': 1,
+                    'usuario_id': 1
+                }
+            ]
+            
+            # Llamamos a la función del servicio
+            resultado = buscar_anuncios("prueba", "Electrónica")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", "Electrónica")
+            
+            # Verificamos que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+    
+    def test_buscar_anuncios_sin_resultados(self):
+        """Prueba búsqueda de anuncios sin resultados"""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock_obtener:
+            # Configuramos el mock para devolver resultados vacíos
+            mock_obtener.return_value = []
+            
+            # Llamamos a la función del servicio
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", None)
+            
+            # Verificamos que el resultado es vacío
+            assert len(resultado) == 0
+    
+    def test_buscar_anuncios_error_en_datos(self):
+        """Prueba manejo de error en la capa de datos"""
+        # Mockeamos la función de datos para que lance una excepción
+        with patch('backend.app.datos.search_ads.obtener_anuncios_por_texto_y_categoria') as mock_obtener:
+            # Configuramos el mock para lanzar una excepción
+            mock_obtener.side_effect = Exception("Error en base de datos")
+            
+            # Verificamos que se lanza la excepción
+            with pytest.raises(Exception) as excinfo:
+                buscar_anuncios("prueba")
+            
+            # Verificamos que el mensaje de error es el esperado
+            assert "Error en base de datos" in str(excinfo.value)
