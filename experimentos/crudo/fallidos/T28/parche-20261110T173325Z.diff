+from backend.app.datos.conexion import conexion
+
+def obtener_anuncios_por_texto_y_categoria(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Obtiene anuncios que coinciden con el texto proporcionado y, opcionalmente, con la categoría.
+    
+    Args:
+        texto: Texto a buscar en los anuncios
+        categoria: Nombre de la categoría a filtrar (opcional)
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is not None:
+                # Buscar anuncios por texto y categoría
+                cur.execute("""
+                    SELECT a.id, a.titulo, a.descripcion, a.precio_centavos, a.categoria_id, a.usuario_id
+                    FROM anuncios a
+                    JOIN categorias c ON a.categoria_id = c.id
+                    WHERE a.titulo LIKE %s OR a.descripcion LIKE %s
+                    AND c.nombre = %s
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            else:
+                # Buscar anuncios por texto solamente
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, categoria_id, usuario_id
+                    FROM anuncios
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                """, (f"%{texto}%", f"%{texto}%"))
+            
+            return cur.fetchall()
