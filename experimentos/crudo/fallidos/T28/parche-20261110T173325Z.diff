+from fastapi import APIRouter, HTTPException
+from typing import Optional
+from backend.app.servicios.search import buscar_anuncios
+
+router = APIRouter(prefix="/search", tags=["Búsqueda"])
+
+@router.get("/")
+def buscar(texto: str, categoria: Optional[str] = None):
+    """
+    Busca anuncios por texto libre y/o categoría.
+    
+    Args:
+        texto: Texto a buscar en los títulos o descripciones de los anuncios
+        categoria: Nombre de la categoría a filtrar (opcional)
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    try:
+        resultados = buscar_anuncios(texto, categoria)
+        return resultados
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error en la búsqueda: {str(e)}")
