+from fastapi import APIRouter, Depends, HTTPException
+from typing import List
+from ..datos.conexion import conexion
+from ..datos.search_ads import buscar_anuncios
+
+router = APIRouter(prefix="/search", tags=["search"])
+
+@router.get("/")
+def search(q: str = "", category: str = ""):
+    """
+    Busca anuncios por título y categoría.
+    
+    Args:
+        q: Texto a buscar en el título
+        category: Categoría a filtrar
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    try:
+        resultados = buscar_anuncios(q, category)
+        return {"results": resultados}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error interno del servidor")
