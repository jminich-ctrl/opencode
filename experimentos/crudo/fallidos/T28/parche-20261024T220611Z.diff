+from .conexion import conexion
+
+def buscar_anuncios(titulo: str = "", categoria: str = "") -> list:
+    """
+    Busca anuncios por título y categoría.
+    
+    Args:
+        titulo: Texto a buscar en el título
+        categoria: Categoría a filtrar
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            # Construimos la consulta SQL dinámica
+            query = "SELECT id, titulo, descripcion, precio, categoria, usuario_id FROM anuncios WHERE 1=1"
+            params = []
+            
+            if titulo:
+                query += " AND titulo LIKE %s"
+                params.append(f"%{titulo}%")
+                
+            if categoria:
+                query += " AND categoria = %s"
+                params.append(categoria)
+                
+            query += " ORDER BY id DESC"
+            
+            cur.execute(query, params)
+            resultados = cur.fetchall()
+            
+            # Convertir los resultados a una lista de diccionarios
+            anuncios = []
+            for row in resultados:
+                anuncio = {
+                    "id": row["id"],
+                    "titulo": row["titulo"],
+                    "descripcion": row["descripcion"],
+                    "precio": row["precio"],
+                    "categoria": row["categoria"],
+                    "usuario_id": row["usuario_id"]
+                }
+                anuncios.append(anuncio)
+                
+            return anuncios
