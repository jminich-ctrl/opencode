+        self.mock_conn.cursor.return_value.__enter__.return_value = self.mock_cursor
+
+    def test_buscar_anuncios_con_texto(self):
+        """Test que busca anuncios por texto"""
+        # Configurar mock
+        self.mock_cursor.fetchall.return_value = [
+            {
+                'id': 1,
+                'titulo': 'Anuncio de prueba',
+                'descripcion': 'Descripción del anuncio',
+                'categoria': 'Electrónica',
+                'precio_centavos': 10000,
+                'usuario_id': 1
+            }
+        ]
+        
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            mock_conexion.return_value.__enter__.return_value = self.mock_conn
+            
+            # Ejecutar
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificaciones
+            assert len(resultado) == 1
+            assert resultado[0]['titulo'] == 'Anuncio de prueba'
+            assert resultado[0]['categoria'] == 'Electrónica'
+            
+            # Verificar que se llamó a execute con los parámetros correctos
+            expected_query = "SELECT a.id, a.titulo, a.descripcion, c.nombre AS categoria, a.precio_centavos, a.usuario_id FROM anuncios a JOIN categorias c ON a.categoria_id = c.id WHERE a.titulo LIKE %s OR a.descripcion LIKE %s"
+            self.mock_cursor.execute.assert_called_once_with(
+                expected_query,
+                ('%prueba%', '%prueba%')
+            )
+
