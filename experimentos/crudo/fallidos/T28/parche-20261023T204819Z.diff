+from backend.app.datos.conexion import conexion
+
+def buscar_anuncios_db(texto: str, categoria: str | None = None) -> list[dict]:
+    """Busca anuncios por texto y categoría en la base de datos."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is None:
+                # Buscar por texto en título o descripción
+                cur.execute("""
+                    SELECT a.id, a.titulo, a.descripcion, c.nombre AS categoria, a.precio_centavos, a.usuario_id 
+                    FROM anuncios a
+                    JOIN categorias c ON a.categoria_id = c.id
+                    WHERE a.titulo LIKE %s OR a.descripcion LIKE %s
+                """, (f'%{texto}%', f'%{texto}%'))
+            else:
+                # Buscar por texto y categoría
+                cur.execute("""
+                    SELECT a.id, a.titulo, a.descripcion, c.nombre AS categoria, a.precio_centavos, a.usuario_id 
+                    FROM anuncios a
+                    JOIN categorias c ON a.categoria_id = c.id
+                    WHERE (a.titulo LIKE %s OR a.descripcion LIKE %s) AND c.nombre = %s
+                """, (f'%{texto}%', f'%{texto}%', categoria))
+            
+            return cur.fetchall()
