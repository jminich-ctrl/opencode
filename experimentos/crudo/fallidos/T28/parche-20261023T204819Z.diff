+from fastapi import APIRouter, Depends, HTTPException
+from backend.app.servicios.search import buscar_anuncios
+
+router = APIRouter(prefix="/search", tags=["búsqueda"])
+
+@router.get("/")
+def buscar_anuncios_endpoint(q: str, category: str | None = None):
+    """Endpoint para buscar anuncios por texto y categoría."""
+    try:
+        resultados = buscar_anuncios(q, category)
+        return {"anuncios": resultados}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error interno del servidor")
