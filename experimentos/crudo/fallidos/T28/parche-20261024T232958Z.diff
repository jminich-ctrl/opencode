+"""
+Módulo de datos para búsqueda de anuncios.
+Contiene funciones para acceder a la base de datos y obtener anuncios según criterios de búsqueda.
+"""
+
+from backend.app.datos.conexion import conexion
+
+
+def obtener_anuncios_buscados(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Obtiene anuncios que coinciden con el texto de búsqueda y, opcionalmente, la categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: Categoría opcional para filtrar los resultados
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            if categoria is None:
+                # Búsqueda solo por texto
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, categoria, usuario_id
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            else:
+                # Búsqueda por texto y categoría
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, categoria, usuario_id
+                    FROM anuncios 
+                    WHERE (titulo LIKE %s OR descripcion LIKE %s) AND categoria = %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            
+            resultados = []
+            for row in cur.fetchall():
+                resultados.append({
+                    "id": row["id"],
+                    "titulo": row["titulo"],
+                    "descripcion": row["descripcion"],
+                    "precio": row["precio_centavos"],
+                    "categoria": row["categoria"],
+                    "usuario_id": row["usuario_id"]
+                })
+            
+            return resultados
