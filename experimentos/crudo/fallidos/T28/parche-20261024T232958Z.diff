+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi import HTTPException
+from backend.app.servicios.search import buscar_anuncios
+from backend.app.datos.search_ads import obtener_anuncios_buscados
+from backend.app.rutas.search import router
+
+
+class TestSearchBackend:
+    """Tests para la funcionalidad de búsqueda de anuncios."""
+    
+    def test_buscar_anuncios_por_texto(self):
+        """Test que busca anuncios por texto."""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_buscados') as mock_obtener:
+            # Configuramos el mock para devolver resultados
+            mock_obtener.return_value = [
+                {
+                    "id": 1,
+                    "titulo": "Anuncio de prueba",
+                    "descripcion": "Descripción del anuncio",
+                    "precio": 1000,
+                    "categoria": "Electrónica",
+                    "usuario_id": 1
+                }
+            ]
+            
+            # Llamamos a la función de servicio
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", None)
+            
+            # Verificamos que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]["titulo"] == "Anuncio de prueba"
+    
+    def test_buscar_anuncios_por_texto_y_categoria(self):
+        """Test que busca anuncios por texto y categoría."""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_buscados') as mock_obtener:
+            # Configuramos el mock para devolver resultados
+            mock_obtener.return_value = [
+                {
+                    "id": 1,
+                    "titulo": "Anuncio de prueba",
+                    "descripcion": "Descripción del anuncio",
+                    "precio": 1000,
+                    "categoria": "Electrónica",
+                    "usuario_id": 1
+                }
+            ]
+            
+            # Llamamos a la función de servicio
+            resultado = buscar_anuncios("prueba", "Electrónica")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", "Electrónica")
+            
+            # Verificamos que el resultado es el esperado
+            assert len(resultado) == 1
+            assert resultado[0]["categoria"] == "Electrónica"
+    
+    def test_buscar_anuncios_sin_resultados(self):
+        """Test que busca anuncios sin encontrar resultados."""
+        # Mockeamos la función de datos
+        with patch('backend.app.datos.search_ads.obtener_anuncios_buscados') as mock_obtener:
+            # Configuramos el mock para devolver resultados vacíos
+            mock_obtener.return_value = []
