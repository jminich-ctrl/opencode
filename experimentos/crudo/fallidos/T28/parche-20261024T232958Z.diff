+            # Llamamos a la función de servicio
+            resultado = buscar_anuncios("prueba")
+            
+            # Verificamos que se llamó a la función de datos con los parámetros correctos
+            mock_obtener.assert_called_once_with("prueba", None)
+            
+            # Verificamos que el resultado es una lista vacía
+            assert resultado == []
