+"""
+Módulo de servicios para búsqueda de anuncios.
+Contiene la lógica de negocio para la búsqueda de anuncios.
+"""
+
+from backend.app.datos.search_ads import obtener_anuncios_buscados
+
+
+def buscar_anuncios(texto: str, categoria: str | None = None) -> list[dict]:
+    """
+    Devuelve anuncios que coinciden con el texto y, opcionalmente, la categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: Categoría opcional para filtrar los resultados
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    return obtener_anuncios_buscados(texto, categoria)
