+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+# Creamos un cliente de prueba
+client = TestClient(app)
+
+class TestSearchBackend:
+    
+    def test_busqueda_por_texto(self):
+        """Prueba búsqueda por texto libre"""
+        with patch('backend.app.datos.search_ads.buscar_anuncios_db') as mock_buscar:
+            # Configuramos el mock para devolver resultados
+            mock_buscar.return_value = [
+                {
+                    "id": 1,
+                    "titulo": "Anuncio de prueba",
+                    "descripcion": "Descripción de prueba",
+                    "precio": 1000,
+                    "usuario_id": 1,
+                    "categoria_id": 1
+                }
+            ]
+            
+            # Hacemos la llamada a la ruta
+            response = client.get("/search?q=prueba")
+            
+            # Verificamos que la respuesta sea correcta
+            assert response.status_code == 200
+            data = response.json()
+            assert len(data) == 1
+            assert data[0]["titulo"] == "Anuncio de prueba"
+    
+    def test_busqueda_por_texto_y_categoria(self):
+        """Prueba búsqueda por texto libre y categoría"""
+        with patch('backend.app.datos.search_ads.buscar_anuncios_db') as mock_buscar:
+            # Configuramos el mock para devolver resultados
+            mock_buscar.return_value = [
+                {
+                    "id": 1,
+                    "titulo": "Anuncio de prueba",
+                    "descripcion": "Descripción de prueba",
+                    "precio": 1000,
+                    "usuario_id": 1,
+                    "categoria_id": 1
+                }
+            ]
+            
+            # Hacemos la llamada a la ruta
+            response = client.get("/search?q=prueba&category=1")
+            
+            # Verificamos que la respuesta sea correcta
+            assert response.status_code == 200
+            data = response.json()
+            assert len(data) == 1
+            assert data[0]["titulo"] == "Anuncio de prueba"
+    
+    def test_busqueda_sin_resultados(self):
+        """Prueba búsqueda sin resultados"""
+        with patch('backend.app.datos.search_ads.buscar_anuncios_db') as mock_buscar:
+            # Configuramos el mock para devolver resultados vacíos
+            mock_buscar.return_value = []
+            
+            # Hacemos la llamada a la ruta
+            response = client.get("/search?q=no_existe")
+            
+            # Verificamos que la respuesta sea correcta
+            assert response.status_code == 200
+            data = response.json()
+            assert len(data) == 0
+    
+    def test_busqueda_parametros_invalidos(self):
+        """Prueba búsqueda con parámetros inválidos"""
+        # Esta prueba debería fallar con un error 400
+        response = client.get("/search?q=")
+        assert response.status_code == 400
