+"""
+Módulo de datos para búsqueda de anuncios.
+"""
+from backend.app.datos.conexion import conexion
+from typing import Optional, List, Dict
+
+def buscar_anuncios_db(texto: str, categoria: Optional[str] = None) -> List[Dict]:
+    """
+    Busca anuncios por texto libre y opcionalmente por categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: ID de categoría opcional para filtrar
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            # Construimos la consulta dinámica
+            if categoria is not None:
+                # Si hay categoría, añadimos el filtro
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio, usuario_id, categoria_id
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    AND categoria_id = %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            else:
+                # Sin categoría, buscamos en todos los anuncios
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio, usuario_id, categoria_id
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            
+            # Devolvemos los resultados como diccionarios
+            return cur.fetchall()
