+"""
+Módulo de servicios para búsqueda de anuncios.
+"""
+from backend.app.datos.search_ads import buscar_anuncios_db
+from typing import Optional, List, Dict
+
+def buscar_anuncios(texto: str, categoria: Optional[str] = None) -> List[Dict]:
+    """
+    Devuelve anuncios que coinciden con el texto y, opcionalmente, la categoría.
+    
+    Args:
+        texto: Texto a buscar en los títulos y descripciones
+        categoria: ID de categoría opcional para filtrar
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    return buscar_anuncios_db(texto, categoria)
