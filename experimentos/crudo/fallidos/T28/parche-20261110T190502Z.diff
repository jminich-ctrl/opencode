+"""
+Ruta de búsqueda de anuncios.
+"""
+from fastapi import APIRouter, Depends, HTTPException
+from typing import Optional
+from backend.app.servicios.search import buscar_anuncios
+
+router = APIRouter(prefix="/search", tags=["búsqueda"])
+
+@router.get("/")
+def buscar_anuncios_endpoint(q: str, category: Optional[str] = None):
+    """
+    Busca anuncios por texto libre y opcionalmente por categoría.
+    
+    Args:
+        q: Texto a buscar en títulos y descripciones
+        category: ID de categoría opcional para filtrar
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios de búsqueda
+    """
+    # Validación básica de parámetros
+    if not q or len(q.strip()) == 0:
+        raise HTTPException(status_code=400, detail="El parámetro 'q' es requerido y no puede estar vacío")
+    
+    try:
+        # Llamamos al servicio de búsqueda
+        resultados = buscar_anuncios(q.strip(), category)
+        return resultados
+    except Exception as e:
+        # En caso de error en la búsqueda, lanzamos una excepción HTTP 500
+        raise HTTPException(status_code=500, detail=f"Error en la búsqueda: {str(e)}")
