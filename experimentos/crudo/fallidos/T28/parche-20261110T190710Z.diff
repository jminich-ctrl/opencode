+from fastapi import APIRouter, Depends, HTTPException
+from typing import Optional
+from backend.app.servicios.search import buscar_anuncios
+
+router = APIRouter(prefix="/search", tags=["Búsqueda"])
+
+@router.get("/")
+def buscar_anuncios_endpoint(q: str, category: Optional[str] = None):
+    """Endpoint para buscar anuncios por texto y categoría.
+    
+    Args:
+        q: Texto a buscar
+        category: ID de categoría opcional para filtrar
+        
+    Returns:
+        Lista de anuncios que coinciden con los criterios
+    """
+    try:
+        resultados = buscar_anuncios(q, category)
+        return resultados
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error al buscar anuncios")
