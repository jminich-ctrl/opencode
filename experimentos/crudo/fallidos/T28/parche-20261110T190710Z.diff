+from backend.app.datos.conexion import conexion
+
+def buscar_anuncios_db(texto: str, categoria: str | None = None) -> list[dict]:
+    """Busca anuncios por texto y categoría.
+    
+    Args:
+        texto: Texto a buscar en los campos de los anuncios
+        categoria: ID de categoría opcional para filtrar
+        
+    Returns:
+        Lista de diccionarios con los anuncios encontrados
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            # Construimos la consulta dinámica
+            if categoria is not None:
+                # Buscamos por texto y categoría
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, categoria_id, usuario_id
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    AND categoria_id = %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%", categoria))
+            else:
+                # Solo buscamos por texto
+                cur.execute("""
+                    SELECT id, titulo, descripcion, precio_centavos, categoria_id, usuario_id
+                    FROM anuncios 
+                    WHERE titulo LIKE %s OR descripcion LIKE %s
+                    ORDER BY id DESC
+                """, (f"%{texto}%", f"%{texto}%"))
+            
+            return cur.fetchall()
