+from backend.app.datos.conexion import conexion
+
+
+def send_message(sender_id: int, receiver_id: int, ad_id: int, content: str) -> dict:
+    """Inserta un mensaje y devuelve el registro creado."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute(
+                "INSERT INTO mensajes (de_usuario_id, a_usuario_id, anuncio_id, cuerpo) VALUES (%s, %s, %s, %s)",
+                (sender_id, receiver_id, ad_id, content)
+            )
+            return {"id": cur.lastrowid}
+
+
+def list_messages(user_id: int) -> list:
+    """Devuelve las conversaciones del usuario."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                SELECT m.id, m.de_usuario_id, m.a_usuario_id, m.anuncio_id, m.cuerpo, m.creado_en
+                FROM mensajes m
+                WHERE (m.de_usuario_id = %s AND m.a_usuario_id = %s) OR (m.de_usuario_id = %s AND m.a_usuario_id = %s)
+                ORDER BY m.creado_en ASC
+                """,
+                (user_id, user_id, user_id, user_id)
+            )
+            return [
+                {
+                    "id": row[0],
+                    "de_usuario_id": row[1],
+                    "a_usuario_id": row[2],
+                    "anuncio_id": row[3],
+                    "cuerpo": row[4],
+                    "creado_en": row[5]
+                }
+                for row in cur.fetchall()
+            ]
+
+
+def get_message(message_id: int) -> dict:
+    """Devuelve el detalle de un mensaje."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute(
+                "SELECT id, de_usuario_id, a_usuario_id, anuncio_id, cuerpo, creado_en FROM mensajes WHERE id = %s",
+                (message_id,)
+            )
+            row = cur.fetchone()
+            if row:
+                return {
+                    "id": row[0],
+                    "de_usuario_id": row[1],
+                    "a_usuario_id": row[2],
+                    "anuncio_id": row[3],
+                    "cuerpo": row[4],
+                    "creado_en": row[5]
+                }
+            return {}
