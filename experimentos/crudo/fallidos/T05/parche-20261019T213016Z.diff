+from backend.app.datos.conexion import conexion
+import pymysql
+
+def insert_ad(title: str, description: str, price: int, user_id: int) -> int:
+    """
+    Inserta un nuevo anuncio en la base de datos.
+    
+    Args:
+        title: Título del anuncio
+        description: Descripción del anuncio
+        price: Precio del anuncio en centavos
+        user_id: ID del usuario dueño del anuncio
+    
+    Returns:
+        ID del nuevo anuncio creado
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                INSERT INTO ads (title, description, price, user_id)
+                VALUES (%s, %s, %s, %s)
+            """, (title, description, price, user_id))
+            conn.commit()
+            return cur.lastrowid
+
+def get_ad_by_id(id: int) -> dict | None:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        id: ID del anuncio a buscar
+    
+    Returns:
+        Diccionario con los datos del anuncio o None si no se encuentra
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                SELECT id, title, description, price, user_id, created_at
+                FROM ads
+                WHERE id = %s
+            """, (id,))
+            result = cur.fetchone()
+            if result:
+                return {
+                    "id": result[0],
+                    "title": result[1],
+                    "description": result[2],
+                    "price": result[3],
+                    "user_id": result[4],
+                    "created_at": result[5].isoformat() if result[5] else None
+                }
+            return None
+
+def update_ad(id: int, title: str | None = None, description: str | None = None, price: int | None = None) -> bool:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        id: ID del anuncio a actualizar
+        title: Nuevo título (opcional)
+        description: Nueva descripción (opcional)
+        price: Nuevo precio (opcional)
+    
+    Returns:
+        True si se actualizó correctamente, False en caso contrario
+    """
+    # Construir la consulta dinámica
+    set_clauses = []
+    values = []
+    
+    if title is not None:
+        set_clauses.append("title = %s")
+        values.append(title)
+    if description is not None:
+        set_clauses.append("description = %s")
+        values.append(description)
+    if price is not None:
+        set_clauses.append("price = %s")
+        values.append(price)
+    
+    if not set_clauses:
+        return False
+    
+    values.append(id)
+    
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            query = f"""
+                UPDATE ads
+                SET {', '.join(set_clauses)}
+                WHERE id = %s
+            """
+            cur.execute(query, values)
+            conn.commit()
+            return cur.rowcount > 0
+
+def delete_ad(id: int) -> bool:
+    """
+    Elimina un anuncio de la base de datos.
+    
+    Args:
+        id: ID del anuncio a eliminar
+    
+    Returns:
+        True si se eliminó correctamente, False en caso contrario
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("DELETE FROM ads WHERE id = %s", (id,))
+            conn.commit()
+            return cur.rowcount > 0
