+from fastapi import APIRouter, Request, Response, HTTPException
+from backend.app.servicios.auth import usuario_desde_token
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.datos.ads import guardar_anuncio, obtener_anuncio_por_id, actualizar_anuncio_db, eliminar_anuncio_db
+import json
+
+router = APIRouter()
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """Crea un nuevo anuncio y devuelve su ID."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(status_code=401, detail="Token requerido")
+    
+    # Obtener usuario desde el token
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Leer el body de la solicitud
+    body = await request.body()
+    try:
+        datos = json.loads(body.decode('utf-8'))
+    except json.JSONDecodeError:
+        raise HTTPException(status_code=400, detail="Datos inválidos")
+    
+    # Validar datos mínimos
+    required_fields = ['title', 'description', 'price']
+    for field in required_fields:
+        if field not in datos:
+            raise HTTPException(status_code=400, detail=f"Campo requerido faltante: {field}")
+    
+    # Crear el anuncio en la base de datos
+    try:
+        anuncio_id = guardar_anuncio(
+            title=datos['title'],
+            description=datos['description'],
+            price=datos['price'],
+            user_id=usuario['id']
+        )
+        return Response(content=json.dumps({"id": anuncio_id}), media_type="application/json")
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error al crear el anuncio")
+
+@router.get("/ads/{id}")
+async def obtener_ad(id: int) -> Response:
+    """Obtiene un anuncio por su ID."""
+    try:
+        anuncio = obtener_anuncio_por_id(id)
+        if not anuncio:
+            raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+        return Response(content=json.dumps(anuncio), media_type="application/json")
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error al obtener el anuncio")
+
+@router.put("/ads/{id}")
+async def actualizar_ad(id: int, request: Request) -> Response:
+    """Actualiza un anuncio existente."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(status_code=401, detail="Token requerido")
+    
+    # Obtener usuario desde el token
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Leer el body de la solicitud
+    body = await request.body()
+    try:
+        datos = json.loads(body.decode('utf-8'))
+    except json.JSONDecodeError:
+        raise HTTPException(status_code=400, detail="Datos inválidos")
+    
+    # Verificar que el anuncio pertenece al usuario
+    try:
+        anuncio = obtener_anuncio_por_id(id)
+        if not anuncio:
+            raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+        if anuncio['user_id'] != usuario['id']:
+            raise HTTPException(status_code=403, detail="Acceso denegado")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    
+    # Actualizar el anuncio en la base de datos
+    try:
+        actualizar_anuncio_db(
+            id=id,
+            title=datos.get('title'),
+            description=datos.get('description'),
+            price=datos.get('price')
+        )
+        return Response(content=json.dumps({"message": "Anuncio actualizado"}), media_type="application/json")
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error al actualizar el anuncio")
+
+@router.delete("/ads/{id}")
+async def eliminar_ad(id: int) -> Response:
+    """Elimina un anuncio existente."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(status_code=401, detail="Token requerido")
+    
+    # Obtener usuario desde el token
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Verificar que el anuncio pertenece al usuario
+    try:
+        anuncio = obtener_anuncio_por_id(id)
+        if not anuncio:
+            raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+        if anuncio['user_id'] != usuario['id']:
+            raise HTTPException(status_code=403, detail="Acceso denegado")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    
+    # Eliminar el anuncio de la base de datos
+    try:
+        eliminar_anuncio_db(id)
+        return Response(content=json.dumps({"message": "Anuncio eliminado"}), media_type="application/json")
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="Error al eliminar el anuncio")
