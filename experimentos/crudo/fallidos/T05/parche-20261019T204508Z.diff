+from fastapi import APIRouter, Request, Response, HTTPException
+from ..servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from ..servicios.auth import usuario_desde_token
+
+router = APIRouter()
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """
+    Crea un nuevo anuncio.
+    
+    Args:
+        request (Request): Petición HTTP con datos del anuncio
+        
+    Returns:
+        Response: Respuesta con el ID del nuevo anuncio
+    """
+    # Obtener token del encabezado
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(401, "Token requerido")
+    
+    # Validar usuario
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(401, "Token inválido")
+    
+    # Parsear datos del cuerpo
+    body = await request.json()
+    titulo = body.get("title")
+    descripcion = body.get("description")
+    precio = body.get("price")
+    
+    try:
+        # Crear anuncio
+        ad_id = crear_anuncio(titulo, descripcion, precio)
+        return Response(content=str(ad_id), status_code=201)
+    except ValueError as e:
+        raise HTTPException(400, str(e))
+
+@router.get("/ads/{ad_id}")
+async def obtener_ad(ad_id: int) -> dict:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a obtener
+        
+    Returns:
+        dict: Datos del anuncio
+    """
+    ad = obtener_anuncio(ad_id)
+    if not ad:
+        raise HTTPException(404, "Anuncio no encontrado")
+    return ad
+
+@router.put("/ads/{ad_id}")
+async def actualizar_ad(ad_id: int, request: Request) -> Response:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        ad_id (int): ID del anuncio a actualizar
+        request (Request): Petición HTTP con nuevos datos del anuncio
+        
+    Returns:
+        Response: Respuesta indicando éxito o error
+    """
+    # Obtener token del encabezado
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(401, "Token requerido")
+    
+    # Validar usuario
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(401, "Token inválido")
+    
+    # Parsear datos del cuerpo
+    body = await request.json()
+    titulo = body.get("title")
+    descripcion = body.get("description")
+    precio = body.get("price")
+    
+    try:
+        # Actualizar anuncio
+        success = actualizar_anuncio(ad_id, titulo, descripcion, precio)
+        if not success:
+            raise HTTPException(404, "Anuncio no encontrado")
+        return Response(status_code=200)
+    except ValueError as e:
+        raise HTTPException(400, str(e))
+
+@router.delete("/ads/{ad_id}")
+async def eliminar_ad(ad_id: int, request: Request) -> Response:
+    """
+    Elimina un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a eliminar
+        request (Request): Petición HTTP
+        
+    Returns:
+        Response: Respuesta indicando éxito o error
+    """
+    # Obtener token del encabezado
+    token = request.headers.get("Authorization")
+    if not token:
+        raise HTTPException(401, "Token requerido")
+    
+    # Validar usuario
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(401, "Token inválido")
+    
+    # Eliminar anuncio
+    success = eliminar_anuncio(ad_id)
+    if not success:
+        raise HTTPException(404, "Anuncio no encontrado")
+    return Response(status_code=200)
