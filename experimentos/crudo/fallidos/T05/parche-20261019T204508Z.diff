+from ..datos.ads import insert_ad, get_ad_by_id, update_ad, delete_ad
+
+def crear_anuncio(titulo: str, descripcion: str, precio: int) -> int:
+    """
+    Crea un nuevo anuncio validando los datos.
+    
+    Args:
+        titulo (str): Título del anuncio
+        descripcion (str): Descripción del anuncio
+        precio (int): Precio del anuncio en centavos
+        
+    Returns:
+        int: ID del nuevo anuncio
+        
+    Raises:
+        ValueError: Si los datos son inválidos
+    """
+    # Validaciones básicas
+    if not titulo or not isinstance(titulo, str) or len(titulo.strip()) == 0:
+        raise ValueError("Título inválido")
+        
+    if not descripcion or not isinstance(descripcion, str) or len(descripcion.strip()) == 0:
+        raise ValueError("Descripción inválida")
+        
+    if not isinstance(precio, int) or precio < 0:
+        raise ValueError("Precio inválido")
+    
+    # Crear el anuncio
+    return insert_ad(titulo.strip(), descripcion.strip(), precio)
+
+def obtener_anuncio(ad_id: int) -> dict | None:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a obtener
+        
+    Returns:
+        dict | None: Datos del anuncio o None si no existe
+    """
+    return get_ad_by_id(ad_id)
+
+def actualizar_anuncio(ad_id: int, titulo: str, descripcion: str, precio: int) -> bool:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        ad_id (int): ID del anuncio a actualizar
+        titulo (str): Nuevo título del anuncio
+        descripcion (str): Nueva descripción del anuncio
+        precio (int): Nuevo precio del anuncio en centavos
+        
+    Returns:
+        bool: True si se actualizó correctamente, False si no existe
+    """
+    # Validaciones básicas
+    if not titulo or not isinstance(titulo, str) or len(titulo.strip()) == 0:
+        raise ValueError("Título inválido")
+        
+    if not descripcion or not isinstance(descripcion, str) or len(descripcion.strip()) == 0:
+        raise ValueError("Descripción inválida")
+        
+    if not isinstance(precio, int) or precio < 0:
+        raise ValueError("Precio inválido")
+    
+    # Actualizar el anuncio
+    return update_ad(ad_id, titulo.strip(), descripcion.strip(), precio)
+
+def eliminar_anuncio(ad_id: int) -> bool:
+    """
+    Elimina un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a eliminar
+        
+    Returns:
+        bool: True si se eliminó correctamente, False si no existe
+    """
+    return delete_ad(ad_id)
