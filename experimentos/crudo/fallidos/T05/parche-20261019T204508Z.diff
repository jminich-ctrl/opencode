+from .conexion import conexion
+
+def insert_ad(titulo: str, descripcion: str, precio: int) -> int:
+    """
+    Inserta un nuevo anuncio en la base de datos.
+    
+    Args:
+        titulo (str): Título del anuncio
+        descripcion (str): Descripción del anuncio  
+        precio (int): Precio del anuncio en centavos
+        
+    Returns:
+        int: ID del nuevo anuncio
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                INSERT INTO ads (title, description, price) 
+                VALUES (%s, %s, %s)
+                RETURNING id
+            """, (titulo, descripcion, precio))
+            result = cur.fetchone()
+            return result['id']
+
+def get_ad_by_id(ad_id: int) -> dict | None:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a buscar
+        
+    Returns:
+        dict | None: Datos del anuncio o None si no existe
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                SELECT id, title, description, price, created_at, updated_at
+                FROM ads 
+                WHERE id = %s
+            """, (ad_id,))
+            result = cur.fetchone()
+            return result
+
+def update_ad(ad_id: int, titulo: str, descripcion: str, precio: int) -> bool:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        ad_id (int): ID del anuncio a actualizar
+        titulo (str): Nuevo título del anuncio
+        descripcion (str): Nueva descripción del anuncio
+        precio (int): Nuevo precio del anuncio en centavos
+        
+    Returns:
+        bool: True si se actualizó correctamente, False si no existe
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                UPDATE ads 
+                SET title = %s, description = %s, price = %s, updated_at = NOW()
+                WHERE id = %s
+            """, (titulo, descripcion, precio, ad_id))
+            return cur.rowcount > 0
+
+def delete_ad(ad_id: int) -> bool:
+    """
+    Elimina un anuncio por su ID.
+    
+    Args:
+        ad_id (int): ID del anuncio a eliminar
+        
+    Returns:
+        bool: True si se eliminó correctamente, False si no existe
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("DELETE FROM ads WHERE id = %s", (ad_id,))
+            return cur.rowcount > 0
