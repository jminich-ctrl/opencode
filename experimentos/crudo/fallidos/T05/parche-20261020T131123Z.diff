+from fastapi import APIRouter, HTTPException, Request, Response
+from pydantic import BaseModel
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.servicios.auth import usuario_desde_token
+
+router = APIRouter()
+
+class AdCreateRequest(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+class AdUpdateRequest(BaseModel):
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """Crea un nuevo anuncio y devuelve su ID."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token or not token.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token no proporcionado o inválido")
+    
+    # Obtener el usuario desde el token
+    user_id = usuario_desde_token(token[7:])  # Quitar "Bearer "
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el body
+    body = await request.json()
+    ad_data = AdCreateRequest(**body)
+    
+    # Llamar al servicio para crear el anuncio
+    ad_id = crear_anuncio(
+        usuario_id=user_id,
+        categoria_id=ad_data.categoria_id,
+        titulo=ad_data.titulo,
+        descripcion=ad_data.descripcion,
+        precio_centavos=ad_data.precio_centavos
+    )
+    
+    # Devolver respuesta con el ID del anuncio creado
+    response = Response(content=str(ad_id), status_code=201)
+    return response
+
+@router.get("/ads/{ad_id}")
+async def obtener_ad(ad_id: int) -> dict:
+    """Obtiene un anuncio por su ID."""
+    ad = obtener_anuncio(ad_id)
+    if ad is None:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return ad
+
+@router.put("/ads/{ad_id}")
+async def actualizar_ad(request: Request, ad_id: int) -> dict:
+    """Actualiza un anuncio existente."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token or not token.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token no proporcionado o inválido")
+    
+    # Obtener el usuario desde el token
+    user_id = usuario_desde_token(token[7:])  # Quitar "Bearer "
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el body
+    body = await request.json()
+    ad_data = AdUpdateRequest(**body)
+    
+    # Llamar al servicio para actualizar el anuncio
+    success = actualizar_anuncio(
+        ad_id=ad_id,
+        usuario_id=user_id,
+        titulo=ad_data.titulo,
+        descripcion=ad_data.descripcion,
+        precio_centavos=ad_data.precio_centavos
+    )
+    
+    if not success:
+        raise HTTPException(status_code=403, detail="No tienes permisos para actualizar este anuncio")
+    
+    return {"message": "Anuncio actualizado correctamente"}
+
+@router.delete("/ads/{ad_id}")
+async def eliminar_ad(request: Request, ad_id: int) -> dict:
+    """Elimina un anuncio existente."""
+    # Obtener el token del header
+    token = request.headers.get("Authorization")
+    if not token or not token.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token no proporcionado o inválido")
+    
+    # Obtener el usuario desde el token
+    user_id = usuario_desde_token(token[7:])  # Quitar "Bearer "
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Llamar al servicio para eliminar el anuncio
+    success = eliminar_anuncio(ad_id=ad_id, usuario_id=user_id)
+    
+    if not success:
+        raise HTTPException(status_code=403, detail="No tienes permisos para eliminar este anuncio")
+    
+    return {"message": "Anuncio eliminado correctamente"}
