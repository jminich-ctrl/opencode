+import pytest
+from unittest.mock import patch
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+class TestAdsBackend:
+    
+    def test_crear_ad_exito(self):
+        """Prueba que se pueda crear un anuncio exitosamente."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.insert_ad', return_value=123) as mock_insert:
+                client = TestClient(app)
+                response = client.post(
+                    "/ads",
+                    json={
+                        "categoria_id": 1,
+                        "titulo": "Anuncio de prueba",
+                        "descripcion": "Descripción de prueba",
+                        "precio_centavos": 10000
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 201
+                assert response.content.decode() == "123"
+                mock_insert.assert_called_once_with(
+                    usuario_id=7,
+                    categoria_id=1,
+                    titulo="Anuncio de prueba",
+                    descripcion="Descripción de prueba",
+                    precio_centavos=10000
+                )
+    
+    def test_obtener_ad_exito(self):
+        """Prueba que se pueda obtener un anuncio existente."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.get_ad_by_id', return_value={
+                "id": 123,
+                "usuario_id": 7,
+                "categoria_id": 1,
+                "titulo": "Anuncio de prueba",
+                "descripcion": "Descripción de prueba",
+                "precio_centavos": 10000,
+                "fecha_creacion": "2023-01-01"
+            }) as mock_get:
+                client = TestClient(app)
+                response = client.get(
+                    "/ads/123",
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 200
+                data = response.json()
+                assert data["id"] == 123
+                assert data["titulo"] == "Anuncio de prueba"
+                mock_get.assert_called_once_with(123)
+    
+    def test_obtener_ad_no_encontrado(self):
+        """Prueba que se devuelva 404 cuando no se encuentra un anuncio."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.get_ad_by_id', return_value=None):
+                client = TestClient(app)
+                response = client.get(
+                    "/ads/999",
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 404
+    
+    def test_actualizar_ad_exito(self):
+        """Prueba que se pueda actualizar un anuncio exitosamente."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.update_ad', return_value=True) as mock_update:
+                client = TestClient(app)
+                response = client.put(
+                    "/ads/123",
+                    json={
+                        "titulo": "Anuncio actualizado",
+                        "descripcion": "Descripción actualizada",
+                        "precio_centavos": 15000
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 200
+                assert response.json()["message"] == "Anuncio actualizado correctamente"
+                mock_update.assert_called_once_with(
+                    ad_id=123,
+                    usuario_id=7,
+                    titulo="Anuncio actualizado",
+                    descripcion="Descripción actualizada",
+                    precio_centavos=15000
+                )
+    
+    def test_actualizar_ad_sin_permisos(self):
+        """Prueba que se devuelva 403 cuando se intenta actualizar un anuncio de otro usuario."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.update_ad', return_value=False):
+                client = TestClient(app)
+                response = client.put(
+                    "/ads/123",
+                    json={
+                        "titulo": "Anuncio actualizado",
+                        "descripcion": "Descripción actualizada",
+                        "precio_centavos": 15000
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 403
+    
+    def test_eliminar_ad_exito(self):
+        """Prueba que se pueda eliminar un anuncio exitosamente."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.delete_ad', return_value=True) as mock_delete:
+                client = TestClient(app)
+                response = client.delete(
+                    "/ads/123",
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 200
+                assert response.json()["message"] == "Anuncio eliminado correctamente"
+                mock_delete.assert_called_once_with(ad_id=123, usuario_id=7)
+    
+    def test_eliminar_ad_sin_permisos(self):
+        """Prueba que se devuelva 403 cuando se intenta eliminar un anuncio de otro usuario."""
+        with patch('backend.app.servicios.auth.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.delete_ad', return_value=False):
+                client = TestClient(app)
+                response = client.delete(
+                    "/ads/123",
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 403
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
