+import pytest
+from unittest.mock import patch
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+class TestAdsBackend:
+    """Tests para las operaciones CRUD de anuncios en el backend."""
+
+    def test_crear_ad_exito(self):
+        """Prueba que se pueda crear un anuncio exitosamente."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.insert_ad', return_value=123) as mock_insert:
+                client = TestClient(app)
+                response = client.post(
+                    "/ads",
+                    json={
+                        "categoria_id": 1,
+                        "titulo": "Anuncio de prueba",
+                        "descripcion": "Descripción de prueba",
+                        "precio_centavos": 1000
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 201
+                assert response.headers["Location"] == "/ads/123"
+                mock_insert.assert_called_once_with(
+                    usuario_id=7,
+                    categoria_id=1,
+                    titulo="Anuncio de prueba",
+                    descripcion="Descripción de prueba",
+                    precio_centavos=1000
+                )
+
+    def test_crear_ad_campos_faltantes(self):
+        """Prueba que se rechacen anuncios con campos faltantes."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            client = TestClient(app)
+            response = client.post(
+                "/ads",
+                json={
+                    "categoria_id": 1,
+                    "titulo": "Anuncio de prueba"
+                    # Faltan descripcion y precio_centavos
+                },
+                headers={"Authorization": "Bearer cualquiera"}
+            )
+            
+            assert response.status_code == 400
+            assert "Campo requerido faltante" in response.json()["error"]
+
+    def test_obtener_ad_exito(self):
+        """Prueba que se pueda obtener un anuncio existente."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.get_ad_by_id', return_value={
+                "id": 123,
+                "usuario_id": 7,
+                "categoria_id": 1,
+                "titulo": "Anuncio de prueba",
+                "descripcion": "Descripción de prueba",
+                "precio_centavos": 1000,
+                "fecha_creacion": "2023-01-01"
+            }) as mock_get:
+                client = TestClient(app)
+                response = client.get("/ads/123", headers={"Authorization": "Bearer cualquiera"})
+                
+                assert response.status_code == 200
+                assert response.json()["titulo"] == "Anuncio de prueba"
+                mock_get.assert_called_once_with(123)
+
+    def test_obtener_ad_no_encontrado(self):
+        """Prueba que se devuelva 404 para un anuncio inexistente."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.get_ad_by_id', return_value=None) as mock_get:
+                client = TestClient(app)
+                response = client.get("/ads/999", headers={"Authorization": "Bearer cualquiera"})
+                
+                assert response.status_code == 404
+                assert "Anuncio no encontrado" in response.json()["error"]
+                mock_get.assert_called_once_with(999)
+
+    def test_actualizar_ad_exito(self):
+        """Prueba que se pueda actualizar un anuncio exitosamente."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.update_ad', return_value=True) as mock_update:
+                client = TestClient(app)
+                response = client.put(
+                    "/ads/123",
+                    json={
+                        "categoria_id": 2,
+                        "titulo": "Anuncio actualizado",
+                        "descripcion": "Descripción actualizada",
+                        "precio_centavos": 1500
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 200
+                mock_update.assert_called_once_with(
+                    ad_id=123,
+                    usuario_id=7,
+                    titulo="Anuncio actualizado",
+                    descripcion="Descripción actualizada",
+                    precio_centavos=1500
+                )
+
+    def test_actualizar_ad_no_autorizado(self):
+        """Prueba que se rechace la actualización de un anuncio de otro usuario."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.update_ad', return_value=False) as mock_update:
+                client = TestClient(app)
+                response = client.put(
+                    "/ads/123",
+                    json={
+                        "categoria_id": 2,
+                        "titulo": "Anuncio actualizado",
+                        "descripcion": "Descripción actualizada",
+                        "precio_centavos": 1500
+                    },
+                    headers={"Authorization": "Bearer cualquiera"}
+                )
+                
+                assert response.status_code == 403
+                assert "No tienes permiso para actualizar este anuncio" in response.json()["error"]
+                mock_update.assert_called_once_with(
+                    ad_id=123,
+                    usuario_id=7,
+                    titulo="Anuncio actualizado",
+                    descripcion="Descripción actualizada",
+                    precio_centavos=1500
+                )
+
+    def test_eliminar_ad_exito(self):
+        """Prueba que se pueda eliminar un anuncio exitosamente."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.delete_ad', return_value=True) as mock_delete:
+                client = TestClient(app)
+                response = client.delete("/ads/123", headers={"Authorization": "Bearer cualquiera"})
+                
+                assert response.status_code == 200
+                mock_delete.assert_called_once_with(ad_id=123, usuario_id=7)
+
+    def test_eliminar_ad_no_autorizado(self):
+        """Prueba que se rechace la eliminación de un anuncio de otro usuario."""
+        with patch('backend.app.rutas.ads.usuario_desde_token', return_value=7):
+            with patch('backend.app.datos.ads.delete_ad', return_value=False) as mock_delete:
+                client = TestClient(app)
+                response = client.delete("/ads/123", headers={"Authorization": "Bearer cualquiera"})
+                
+                assert response.status_code == 403
+                assert "No tienes permiso para eliminar este anuncio" in response.json()["error"]
+                mock_delete.assert_called_once_with(ad_id=123, usuario_id=7)
