+from fastapi import APIRouter, Request, Response, HTTPException
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.servicios.auth import usuario_desde_token
+
+router = APIRouter()
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """Crea un nuevo anuncio y devuelve su ID."""
+    # Obtener el usuario desde el token
+    usuario_id = usuario_desde_token(request.headers.get("Authorization"))
+    
+    # Leer los datos del cuerpo de la solicitud
+    data = await request.json()
+    
+    # Validar que los campos obligatorios estén presentes
+    required_fields = ['categoria_id', 'titulo', 'descripcion', 'precio_centavos']
+    for field in required_fields:
+        if field not in data:
+            raise HTTPException(status_code=400, detail=f"Campo requerido faltante: {field}")
+    
+    # Crear el anuncio usando el servicio
+    ad_id = crear_anuncio(
+        usuario_id=usuario_id,
+        categoria_id=data['categoria_id'],
+        titulo=data['titulo'],
+        descripcion=data['descripcion'],
+        precio_centavos=data['precio_centavos']
+    )
+    
+    # Devolver respuesta con el ID del anuncio creado
+    response = Response(status_code=201)
+    response.headers["Location"] = f"/ads/{ad_id}"
+    return response
+
+@router.get("/ads/{id}")
+async def obtener_ad(id: int, request: Request) -> dict:
+    """Obtiene un anuncio por su ID."""
+    # Obtener el usuario desde el token
+    usuario_id = usuario_desde_token(request.headers.get("Authorization"))
+    
+    ad = obtener_anuncio(id)
+    if ad is None:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return ad
+
+@router.put("/ads/{id}")
+async def actualizar_ad(id: int, request: Request) -> Response:
+    """Actualiza un anuncio si pertenece al usuario actual."""
+    # Obtener el usuario desde el token
+    usuario_id = usuario_desde_token(request.headers.get("Authorization"))
+    
+    # Leer los datos del cuerpo de la solicitud
+    data = await request.json()
+    
+    # Validar que los campos obligatorios estén presentes
+    required_fields = ['categoria_id', 'titulo', 'descripcion', 'precio_centavos']
+    for field in required_fields:
+        if field not in data:
+            raise HTTPException(status_code=400, detail=f"Campo requerido faltante: {field}")
+    
+    # Actualizar el anuncio usando el servicio
+    success = actualizar_anuncio(
+        ad_id=id,
+        usuario_id=usuario_id,
+        titulo=data['titulo'],
+        descripcion=data['descripcion'],
+        precio_centavos=data['precio_centavos']
+    )
+    
+    if not success:
+        raise HTTPException(status_code=403, detail="No tienes permiso para actualizar este anuncio")
+    
+    return Response(status_code=200)
+
+@router.delete("/ads/{id}")
+async def eliminar_ad(id: int, request: Request) -> Response:
+    """Elimina un anuncio si pertenece al usuario actual."""
+    # Obtener el usuario desde el token
+    usuario_id = usuario_desde_token(request.headers.get("Authorization"))
+    
+    # Eliminar el anuncio usando el servicio
+    success = eliminar_anuncio(ad_id=id, usuario_id=usuario_id)
+    
+    if not success:
+        raise HTTPException(status_code=403, detail="No tienes permiso para eliminar este anuncio")
+    
+    return Response(status_code=200)
