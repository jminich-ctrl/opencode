+from fastapi import APIRouter, Request, Response, HTTPException
+from ..servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from ..servicios.auth import usuario_desde_token
+
+router = APIRouter()
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """Crea un nuevo anuncio y devuelve su ID."""
+    # Obtener el token del encabezado
+    token = request.headers.get("Authorization", "").replace("Bearer ", "")
+    
+    # Validar autenticación
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el cuerpo de la solicitud
+    body = await request.json()
+    
+    # Extraer datos del cuerpo
+    titulo = body.get("title")
+    descripcion = body.get("description")
+    precio = body.get("price")
+    
+    try:
+        # Crear el anuncio
+        ad_id = crear_anuncio(titulo, descripcion, precio)
+        
+        # Devolver respuesta con el ID del anuncio creado
+        response = Response(content=str(ad_id), status_code=201)
+        return response
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+@router.get("/ads/{id}")
+async def obtener_ad(id: int) -> dict:
+    """Obtiene un anuncio por su ID."""
+    ad = obtener_anuncio(id)
+    
+    if ad is None:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+        
+    return {
+        "id": ad["id"],
+        "title": ad["title"],
+        "description": ad["description"],
+        "price": ad["price"],
+        "created_at": ad["created_at"]
+    }
+
+@router.put("/ads/{id}")
+async def actualizar_ad(id: int, request: Request) -> Response:
+    """Actualiza un anuncio existente."""
+    # Obtener el token del encabezado
+    token = request.headers.get("Authorization", "").replace("Bearer ", "")
+    
+    # Validar autenticación
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el cuerpo de la solicitud
+    body = await request.json()
+    
+    # Extraer datos del cuerpo
+    titulo = body.get("title")
+    descripcion = body.get("description")
+    precio = body.get("price")
+    
+    try:
+        # Actualizar el anuncio
+        success = actualizar_anuncio(id, titulo, descripcion, precio)
+        
+        if not success:
+            raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+            
+        return Response(status_code=200)
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+@router.delete("/ads/{id}")
+async def eliminar_ad(id: int, request: Request) -> Response:
+    """Elimina un anuncio existente."""
+    # Obtener el token del encabezado
+    token = request.headers.get("Authorization", "").replace("Bearer ", "")
+    
+    # Validar autenticación
+    try:
+        usuario = usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Eliminar el anuncio
+    success = eliminar_anuncio(id)
+    
+    if not success:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+        
+    return Response(status_code=200)
