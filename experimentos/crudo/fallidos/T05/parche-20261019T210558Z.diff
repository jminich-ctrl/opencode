+from .conexion import conexion
+
+def insert_ad(titulo: str, descripcion: str, precio: int) -> int:
+    """Inserta un nuevo anuncio en la base de datos y devuelve su ID."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                INSERT INTO ads (title, description, price) 
+                VALUES (%s, %s, %s)
+            """, (titulo, descripcion, precio))
+            conn.commit()
+            # Obtener el ID del último registro insertado
+            cur.execute("SELECT LAST_INSERT_ID()")
+            result = cur.fetchone()
+            return result['LAST_INSERT_ID()'] if result else None
+
+def get_ad_by_id(ad_id: int) -> dict:
+    """Obtiene un anuncio por su ID."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                SELECT id, title, description, price, created_at 
+                FROM ads 
+                WHERE id = %s
+            """, (ad_id,))
+            result = cur.fetchone()
+            return result
+
+def update_ad(ad_id: int, titulo: str, descripcion: str, precio: int) -> bool:
+    """Actualiza un anuncio existente."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                UPDATE ads 
+                SET title = %s, description = %s, price = %s
+                WHERE id = %s
+            """, (titulo, descripcion, precio, ad_id))
+            return cur.rowcount > 0
+
+def delete_ad(ad_id: int) -> bool:
+    """Elimina un anuncio existente."""
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("DELETE FROM ads WHERE id = %s", (ad_id,))
+            return cur.rowcount > 0
