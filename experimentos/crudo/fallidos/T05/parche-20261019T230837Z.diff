+"""
+Tests para las operaciones CRUD de anuncios en el backend.
+"""
+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+
+
+class TestAdsBackend:
+    """Tests para las operaciones CRUD de anuncios."""
+
+    def test_crear_anuncio(self):
+        """Test para crear un anuncio."""
+        with patch('backend.app.datos.ads.insert_ad') as mock_insert:
+            mock_insert.return_value = 123
+            
+            result = crear_anuncio(
+                usuario_id=1,
+                categoria_id=2,
+                titulo="Anuncio de prueba",
+                descripcion="Descripción de prueba",
+                precio_centavos=1000
+            )
+            
+            assert result == 123
+            mock_insert.assert_called_once_with(
+                usuario_id=1,
+                categoria_id=2,
+                titulo="Anuncio de prueba",
+                descripcion="Descripción de prueba",
+                precio_centavos=1000
+            )
+
+    def test_obtener_anuncio_existe(self):
+        """Test para obtener un anuncio que existe."""
+        with patch('backend.app.datos.ads.get_ad_by_id') as mock_get:
+            mock_get.return_value = {
+                "id": 123,
+                "usuario_id": 1,
+                "categoria_id": 2,
+                "titulo": "Anuncio de prueba",
+                "descripcion": "Descripción de prueba",
+                "precio_centavos": 1000
+            }
+            
+            result = obtener_anuncio(123)
+            
+            assert result is not None
+            assert result["id"] == 123
+            assert result["titulo"] == "Anuncio de prueba"
+            mock_get.assert_called_once_with(123)
+
+    def test_obtener_anuncio_no_existe(self):
+        """Test para obtener un anuncio que no existe."""
+        with patch('backend.app.datos.ads.get_ad_by_id') as mock_get:
+            mock_get.return_value = None
+            
+            result = obtener_anuncio(123)
+            
+            assert result is None
+            mock_get.assert_called_once_with(123)
+
+    def test_actualizar_anuncio_correcto(self):
+        """Test para actualizar un anuncio correctamente."""
+        with patch('backend.app.datos.ads.update_ad') as mock_update:
+            mock_update.return_value = True
+            
+            result = actualizar_anuncio(
+                ad_id=123,
+                usuario_id=1,
+                titulo="Anuncio actualizado",
+                descripcion="Descripción actualizada",
+                precio_centavos=2000
+            )
+            
+            assert result is True
+            mock_update.assert_called_once_with(
+                ad_id=123,
+                usuario_id=1,
+                titulo="Anuncio actualizado",
+                descripcion="Descripción actualizada",
+                precio_centavos=2000
+            )
+
+    def test_actualizar_anuncio_usuario_incorrecto(self):
+        """Test para intentar actualizar un anuncio de otro usuario."""
+        with patch('backend.app.datos.ads.update_ad') as mock_update:
+            mock_update.return_value = False
+            
+            result = actualizar_anuncio(
+                ad_id=123,
+                usuario_id=2,  # Usuario diferente
+                titulo="Anuncio actualizado",
+                descripcion="Descripción actualizada",
+                precio_centavos=2000
+            )
+            
+            assert result is False
+            mock_update.assert_called_once_with(
+                ad_id=123,
+                usuario_id=2,
+                titulo="Anuncio actualizado",
+                descripcion="Descripción actualizada",
+                precio_centavos=2000
+            )
+
+    def test_eliminar_anuncio_correcto(self):
+        """Test para eliminar un anuncio correctamente."""
+        with patch('backend.app.datos.ads.delete_ad') as mock_delete:
+            mock_delete.return_value = True
+            
+            result = eliminar_anuncio(
+                ad_id=123,
+                usuario_id=1
+            )
+            
+            assert result is True
+            mock_delete.assert_called_once_with(
+                ad_id=123,
+                usuario_id=1
+            )
+
+    def test_eliminar_anuncio_usuario_incorrecto(self):
+        """Test para intentar eliminar un anuncio de otro usuario."""
+        with patch('backend.app.datos.ads.delete_ad') as mock_delete:
+            mock_delete.return_value = False
+            
+            result = eliminar_anuncio(
+                ad_id=123,
+                usuario_id=2  # Usuario diferente
+            )
+            
+            assert result is False
+            mock_delete.assert_called_once_with(
+                ad_id=123,
+                usuario_id=2
+            )
