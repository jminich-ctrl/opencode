+"""
+Funciones de acceso a datos para anuncios.
+"""
+from backend.app.datos.conexion import conexion
+
+
+def insert_ad(usuario_id: int, categoria_id: int, titulo: str, descripcion: str,
+              precio_centavos: int) -> int:
+    """
+    Inserta un nuevo anuncio en la base de datos.
+    
+    Args:
+        usuario_id: ID del usuario dueño del anuncio
+        categoria_id: ID de la categoría del anuncio
+        titulo: Título del anuncio
+        descripcion: Descripción del anuncio
+        precio_centavos: Precio en centavos
+    
+    Returns:
+        ID del nuevo anuncio creado
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                INSERT INTO anuncios (usuario_id, categoria_id, titulo, descripcion, precio_centavos)
+                VALUES (%s, %s, %s, %s, %s)
+            """, (usuario_id, categoria_id, titulo, descripcion, precio_centavos))
+            return cur.lastrowid
+
+
+def get_ad_by_id(ad_id: int) -> dict | None:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        ad_id: ID del anuncio a buscar
+        
+    Returns:
+        Diccionario con los datos del anuncio o None si no existe
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                SELECT id, usuario_id, categoria_id, titulo, descripcion, precio_centavos, creado_en
+                FROM anuncios 
+                WHERE id = %s
+            """, (ad_id,))
+            fila = cur.fetchone()
+            if fila:
+                return {
+                    'id': fila[0],
+                    'usuario_id': fila[1],
+                    'categoria_id': fila[2],
+                    'titulo': fila[3],
+                    'descripcion': fila[4],
+                    'precio_centavos': fila[5],
+                    'creado_en': fila[6]
+                }
+            return None
+
+
+def update_ad(ad_id: int, usuario_id: int, titulo: str, descripcion: str,
+              precio_centavos: int) -> bool:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        ad_id: ID del anuncio a actualizar
+        usuario_id: ID del usuario que intenta actualizar
+        titulo: Nuevo título del anuncio
+        descripcion: Nueva descripción del anuncio
+        precio_centavos: Nuevo precio en centavos
+        
+    Returns:
+        True si se actualizó correctamente, False si el anuncio no pertenece al usuario
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                UPDATE anuncios 
+                SET titulo = %s, descripcion = %s, precio_centavos = %s
+                WHERE id = %s AND usuario_id = %s
+            """, (titulo, descripcion, precio_centavos, ad_id, usuario_id))
+            return cur.rowcount > 0
+
+
+def delete_ad(ad_id: int, usuario_id: int) -> bool:
+    """
+    Elimina un anuncio.
+    
+    Args:
+        ad_id: ID del anuncio a eliminar
+        usuario_id: ID del usuario que intenta eliminar
+        
+    Returns:
+        True si se eliminó correctamente, False si el anuncio no pertenece al usuario
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("""
+                DELETE FROM anuncios 
+                WHERE id = %s AND usuario_id = %s
+            """, (ad_id, usuario_id))
+            return cur.rowcount > 0
