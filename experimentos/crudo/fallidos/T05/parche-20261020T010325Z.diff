+"""
+Rutas para operaciones con anuncios.
+"""
+from fastapi import APIRouter, Request, Response, HTTPException
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.servicios.auth import usuario_desde_token
+
+router = APIRouter()
+
+
+@router.post("/ads")
+async def crear_ad(request: Request) -> Response:
+    """
+    Crea un nuevo anuncio.
+    
+    Args:
+        request: Objeto de solicitud HTTP
+        
+    Returns:
+        Response con el ID del nuevo anuncio
+    """
+    # Obtener token del encabezado Authorization
+    auth_header = request.headers.get("Authorization")
+    if not auth_header or not auth_header.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token de autenticación requerido")
+    
+    token = auth_header.split(" ")[1]
+    
+    # Obtener usuario desde el token
+    try:
+        usuario_id = usuario_desde_token(token)
+        if usuario_id is None:
+            raise HTTPException(status_code=401, detail="Token inválido")
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el cuerpo de la solicitud
+    body = await request.json()
+    
+    # Validar campos requeridos
+    required_fields = ["categoria_id", "titulo", "descripcion", "precio_centavos"]
+    for field in required_fields:
+        if field not in body:
+            raise HTTPException(status_code=400, detail=f"Campo requerido faltante: {field}")
+    
+    # Extraer datos del cuerpo
+    categoria_id = body["categoria_id"]
+    titulo = body["titulo"]
+    descripcion = body["descripcion"]
+    precio_centavos = body["precio_centavos"]
+    
+    # Crear el anuncio
+    try:
+        ad_id = crear_anuncio(usuario_id, categoria_id, titulo, descripcion, precio_centavos)
+        return Response(content=str(ad_id), status_code=201)
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error al crear el anuncio: {str(e)}")
+
+
+@router.get("/ads/{id}")
+async def obtener_ad(id: int) -> dict:
+    """
+    Obtiene un anuncio por su ID.
+    
+    Args:
+        id: ID del anuncio a obtener
+        
+    Returns:
+        Diccionario con los datos del anuncio
+    """
+    ad = obtener_anuncio(id)
+    if not ad:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return ad
+
+
+@router.put("/ads/{id}")
+async def actualizar_ad(id: int, request: Request) -> dict:
+    """
+    Actualiza un anuncio existente.
+    
+    Args:
+        id: ID del anuncio a actualizar
+        request: Objeto de solicitud HTTP
+        
+    Returns:
+        Diccionario con mensaje de éxito o error
+    """
+    # Obtener token del encabezado Authorization
+    auth_header = request.headers.get("Authorization")
+    if not auth_header or not auth_header.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token de autenticación requerido")
+    
+    token = auth_header.split(" ")[1]
+    
+    # Obtener usuario desde el token
+    try:
+        usuario_id = usuario_desde_token(token)
+        if usuario_id is None:
+            raise HTTPException(status_code=401, detail="Token inválido")
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Parsear el cuerpo de la solicitud
+    body = await request.json()
+    
+    # Validar campos requeridos
+    required_fields = ["categoria_id", "titulo", "descripcion", "precio_centavos"]
+    for field in required_fields:
+        if field not in body:
+            raise HTTPException(status_code=400, detail=f"Campo requerido faltante: {field}")
+    
+    # Extraer datos del cuerpo
+    categoria_id = body["categoria_id"]
+    titulo = body["titulo"]
+    descripcion = body["descripcion"]
+    precio_centavos = body["precio_centavos"]
+    
+    # Actualizar el anuncio
+    try:
+        success = actualizar_anuncio(id, usuario_id, titulo, descripcion, precio_centavos)
+        if not success:
+            raise HTTPException(status_code=403, detail="No tienes permisos para actualizar este anuncio")
+        return {"message": "Anuncio actualizado exitosamente"}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error al actualizar el anuncio: {str(e)}")
+
+
+@router.delete("/ads/{id}")
+async def eliminar_ad(id: int, request: Request) -> dict:
+    """
+    Elimina un anuncio.
+    
+    Args:
+        id: ID del anuncio a eliminar
+        request: Objeto de solicitud HTTP
+        
+    Returns:
+        Diccionario con mensaje de éxito o error
+    """
+    # Obtener token del encabezado Authorization
+    auth_header = request.headers.get("Authorization")
+    if not auth_header or not auth_header.startswith("Bearer "):
+        raise HTTPException(status_code=401, detail="Token de autenticación requerido")
+    
+    token = auth_header.split(" ")[1]
+    
+    # Obtener usuario desde el token
+    try:
+        usuario_id = usuario_desde_token(token)
+        if usuario_id is None:
+            raise HTTPException(status_code=401, detail="Token inválido")
+    except Exception:
+        raise HTTPException(status_code=401, detail="Token inválido")
+    
+    # Eliminar el anuncio
+    try:
+        success = eliminar_anuncio(id, usuario_id)
+        if not success:
+            raise HTTPException(status_code=403, detail="No tienes permisos para eliminar este anuncio")
+        return {"message": "Anuncio eliminado exitosamente"}
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Error al eliminar el anuncio: {str(e)}")
