 from backend.app.datos import users
 
+def usuario_desde_token(token: str) -> int | None:
+    """El id del usuario dueño del token, o None si el token no es válido."""
+    if not token or not isinstance(token, str):
+        return None
+    
+    # Verificar si el token tiene el formato esperado
+    # El token es de la forma "mocked-token-for-user-{id}"
+    if token.startswith("mocked-token-for-user-"):
+        try:
+            # Extraer el ID del usuario del token
+            user_id_str = token.split("-")[-1]
+            user_id = int(user_id_str)
+            # Verificar que el usuario exista
+            user = users.read_user_by_email(str(user_id))
+            if user is not None:
+                return user_id
+        except (ValueError, IndexError):
+            # Si no se puede extraer el ID o no es un número válido
+            return None
+    
+    # Si el token no tiene el formato esperado o no es válido
+    return None
+
 def login(email: str, password: str) -> dict | None:
     """Verifica credenciales. Devuelve algo con `token` si son válidas, o None."""
     # Obtener el usuario por email
