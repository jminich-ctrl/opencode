from fastapi import APIRouter, Depends, HTTPException
from backend.app.datos.favorites import toggle_favorite, get_user_favorites
from backend.app.datos.auth import get_current_user
from backend.app.modelos import Usuario

router = APIRouter()

@router.post("/favorites/toggle")
async def toggle_favorite_endpoint(
    user_id: int, 
    ad_id: int,
    current_user: Usuario = Depends(get_current_user)
):
    """
    Endpoint que delega al servicio para marcar/desmarcar favorito.
    """
    # Verificar que el usuario actual sea el mismo que el user_id pasado
    if current_user.id != user_id:
        raise HTTPException(status_code=403, detail="No autorizado")
    
    return toggle_favorite(user_id, ad_id)

@router.get("/favorites/list/{user_id}")
async def list_user_favorites(
    user_id: int,
    current_user: Usuario = Depends(get_current_user)
):
    """
    Endpoint que devuelve la lista de favoritos de un usuario.
    """
    # Verificar que el usuario actual sea el mismo que el user_id pasado
    if current_user.id != user_id:
        raise HTTPException(status_code=403, detail="No autorizado")
    
    return get_user_favorites(user_id)
