+from fastapi import APIRouter, HTTPException
+from pydantic import BaseModel
+from backend.app.datos import conexion
+from backend.app.datos.favorites import toggle_favorite as datos_toggle_favorite, get_user_favorites
+from backend.app.datos.ads import get_ad_by_id
+
+router = APIRouter()
+
+class ToggleFavoriteRequest(BaseModel):
+    user_id: int
+    ad_id: int
+
+# Funciones que se van a mockear en los tests
+# Definimos estas funciones directamente en el módulo para que puedan ser mockeadas
+def toggle_favorite(user_id: int, ad_id: int) -> bool:
+    """Función que marca/desmarca favorito.
+    Devuelve True si quedó como favorito, False si se eliminó.
+    """
+    # Esta función será reemplazada por el mock en los tests
+    # En producción simplemente llama a la función real de datos
+    try:
+        # Llamamos a la función real de datos (usando alias para evitar conflicto)
+        result = datos_toggle_favorite(user_id, ad_id)
+        return result
+    except Exception as e:
+        if "not found" in str(e).lower():
+            raise HTTPException(status_code=404, detail="User not found")
+        raise HTTPException(status_code=500, detail="Internal server error")
+
+def list_favorites(user_id: int) -> list:
+    """Función que devuelve la lista de anuncios favoritos del usuario.
+    Devuelve una lista de objetos con las claves: id, ad_id, favorited (bool) y status (str).
+    """
+    # Esta función será reemplazada por el mock en los tests
+    # En producción simplemente llama a la función real
+    try:
+        # Obtener los IDs de los anuncios favoritos del usuario
+        favorite_ad_ids = get_user_favorites(user_id)
+        
+        # Construir la lista de favoritos con información completa
+        favorites = []
+        for ad_id in favorite_ad_ids:
+            ad_data = get_ad_by_id(ad_id)
+            if ad_data:  # Solo incluir si el anuncio existe
+                # Para el status, vamos a usar un valor fijo como "active" 
+                # ya que no tenemos información específica de estado en el esquema
+                favorites.append({
+                    "id": ad_data["id"],
+                    "ad_id": ad_data["id"],
+                    "favorited": True,
+                    "status": "active"
+                })
+        
+        return favorites
+    except Exception as e:
+        if "not found" in str(e).lower():
+            raise HTTPException(status_code=404, detail="User not found")
+        raise HTTPException(status_code=500, detail="Internal server error")
+
+@router.post("/favorites/toggle")
+async def toggle_favorite_endpoint(request: ToggleFavoriteRequest):
+    """Endpoint que marca/desmarca un anuncio como favorito.
+    Devuelve 200 OK con cuerpo vacío si la operación es exitosa.
+    Si el usuario no existe, devuelve 404.
+    """
+    try:
+        # Llamamos a la función auxiliar definida en este módulo
+        result = toggle_favorite(request.user_id, request.ad_id)
+        return {}
+    except HTTPException:
+        # Re-lanzamos HTTPExceptions para que sean manejadas por el manejador
+        raise
+    except Exception:
+        # Para cualquier otro error, devolvemos 500
+        raise HTTPException(status_code=500, detail="Internal server error")
+
+@router.get("/favorites/list")
+async def list_favorites_endpoint(user_id: int):
+    """Endpoint que devuelve la lista de anuncios favoritos del usuario.
+    Devuelve 200 OK con un JSON que contiene una lista de objetos con las
+    claves: id, ad_id, favorited (bool) y status (str).
+    """
+    try:
+        # Llamamos a la función auxiliar definida en este módulo
+        result = list_favorites(user_id)
+        return result
+    except HTTPException:
+        # Re-lanzamos HTTPExceptions para que sean manejadas por el manejador
+        raise
+    except Exception:
+        # Para cualquier otro error, devolvemos 500
+        raise HTTPException(status_code=500, detail="Internal server error")
