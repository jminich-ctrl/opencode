+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+from backend.app.datos import conexion
+
+
+class TestFavoritesRutas:
+    @pytest.fixture(autouse=True)
+    def setup(self):
+        self.client = TestClient(app)
+        # Mockeamos la conexión a la base de datos
+        self.mock_conexion = patch('backend.app.datos.conexion', return_value=MagicMock())
+        self.mock_conexion.start()
+        
+        # Mockeamos los servicios de favoritos
+        self.mock_toggle_favorite = patch('backend.app.rutas.favorites.toggle_favorite')
+        self.mock_list_favorites = patch('backend.app.rutas.favorites.list_favorites')
+        self.mock_toggle_favorite.start()
+        self.mock_list_favorites.start()
+
+    def teardown(self):
+        self.mock_conexion.stop()
+        self.mock_toggle_favorite.stop()
+        self.mock_list_favorites.stop()
+
+    def test_toggle_favorite_success(self):
+        """Prueba que el endpoint toggle_favorite funcione correctamente."""
+        # Configuramos el mock para que devuelva un resultado exitoso
+        self.mock_toggle_favorite.return_value = True
+        
+        response = self.client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 2})
+        
+        assert response.status_code == 200
+        assert response.json() == {}
+
+    def test_toggle_favorite_user_not_found(self):
+        """Prueba que el endpoint toggle_favorite devuelva 404 si el usuario no existe."""
+        # Configuramos el mock para que lance una excepción de usuario no encontrado
+        self.mock_toggle_favorite.side_effect = Exception("User not found")
+        
+        response = self.client.post("/favorites/toggle", json={"user_id": 999, "ad_id": 2})
+        
+        assert response.status_code == 404
+
+    def test_list_favorites_success(self):
+        """Prueba que el endpoint list_favorites funcione correctamente."""
+        # Configuramos el mock para que devuelva una lista de favoritos
+        mock_favorites = [
+            {"id": 1, "ad_id": 2, "favorited": True, "status": "active"},
+            {"id": 2, "ad_id": 3, "favorited": True, "status": "inactive"}
+        ]
+        self.mock_list_favorites.return_value = mock_favorites
+        
+        response = self.client.get("/favorites/list", params={"user_id": 1})
+        
+        assert response.status_code == 200
+        assert response.json() == mock_favorites
+
+    def test_list_favorites_empty(self):
+        """Prueba que el endpoint list_favorites devuelva una lista vacía si no hay favoritos."""
+        # Configuramos el mock para que devuelva una lista vacía
+        self.mock_list_favorites.return_value = []
+        
+        response = self.client.get("/favorites/list", params={"user_id": 1})
+        
+        assert response.status_code == 200
+        assert response.json() == []
