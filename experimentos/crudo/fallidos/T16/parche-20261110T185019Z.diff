+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+# Creamos un cliente de prueba
+client = TestClient(app)
+
+class TestFavoritesRutas:
+    
+    def test_toggle_favorite_endpoint_success(self):
+        """Prueba que el endpoint toggle_favorite funcione correctamente."""
+        # Mockeamos las funciones necesarias
+        with patch('backend.app.datos.favorites.toggle_favorite') as mock_toggle:
+            with patch('backend.app.datos.conexion') as mock_conexion:
+                # Configuramos el mock de la conexión
+                mock_conn = MagicMock()
+                mock_cur = MagicMock()
+                mock_conexion.return_value.__enter__.return_value = mock_conn
+                mock_conn.cursor.return_value.__enter__.return_value = mock_cur
+                
+                # Simulamos que el usuario existe
+                mock_cur.fetchone.return_value = True
+                
+                # Configuramos el mock de toggle_favorite para devolver True
+                mock_toggle.return_value = True
+                
+                # Hacemos la llamada al endpoint
+                response = client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 1})
+                
+                # Verificamos que la respuesta sea correcta
+                assert response.status_code == 200
+                assert response.json()["status"] == "success"
+                assert response.json()["favorited"] == True
+    
+    def test_toggle_favorite_endpoint_user_not_found(self):
+        """Prueba que el endpoint toggle_favorite maneje correctamente el caso de usuario no encontrado."""
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            # Configuramos el mock de la conexión
+            mock_conn = MagicMock()
+            mock_cur = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_value.__enter__.return_value = mock_cur
+            
+            # Simulamos que el usuario no existe
+            mock_cur.fetchone.return_value = None
+            
+            # Hacemos la llamada al endpoint
+            response = client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 1})
+            
+            # Verificamos que se devuelva un error 404
+            assert response.status_code == 404
+            assert "Usuario no encontrado" in response.json()["error"]
+    
+    def test_list_user_favorites_endpoint_success(self):
+        """Prueba que el endpoint list_user_favorites funcione correctamente."""
+        # Mockeamos las funciones necesarias
+        with patch('backend.app.datos.favorites.get_user_favorites') as mock_list:
+            with patch('backend.app.datos.conexion') as mock_conexion:
+                # Configuramos el mock de la conexión
+                mock_conn = MagicMock()
+                mock_cur = MagicMock()
+                mock_conexion.return_value.__enter__.return_value = mock_conn
+                mock_conn.cursor.return_value.__enter__.return_value = mock_cur
+                
+                # Simulamos que el usuario existe
+                mock_cur.fetchone.return_value = True
+                
+                # Configuramos el mock de get_user_favorites para devolver una lista
+                mock_list.return_value = [1, 2, 3]
+                
+                # Hacemos la llamada al endpoint
+                response = client.get("/favorites/list", params={"user_id": 1})
+                
+                # Verificamos que la respuesta sea correcta
+                assert response.status_code == 200
+                assert response.json()["favorites"] == [1, 2, 3]
+    
+    def test_list_user_favorites_endpoint_user_not_found(self):
+        """Prueba que el endpoint list_user_favorites maneje correctamente el caso de usuario no encontrado."""
+        with patch('backend.app.datos.conexion') as mock_conexion:
+            # Configuramos el mock de la conexión
+            mock_conn = MagicMock()
+            mock_cur = MagicMock()
+            mock_conexion.return_value.__enter__.return_value = mock_conn
+            mock_conn.cursor.return_value.__enter__.return_value = mock_cur
+            
+            # Simulamos que el usuario no existe
+            mock_cur.fetchone.return_value = None
+            
+            # Hacemos la llamada al endpoint
+            response = client.get("/favorites/list", params={"user_id": 1})
+            
+            # Verificamos que se devuelva un error 404
+            assert response.status_code == 404
+            assert "Usuario no encontrado" in response.json()["error"]
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
