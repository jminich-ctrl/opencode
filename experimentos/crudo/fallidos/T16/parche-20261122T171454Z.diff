+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+from backend.app.datos import conexion
+
+
+class TestFavoritesRutas:
+    @pytest.fixture(autouse=True)
+    def setup(self):
+        self.client = TestClient(app)
+        # Mockear la conexión a la base de datos
+        self.patcher = patch('backend.app.datos.conexion')
+        self.mock_conexion = self.patcher.start()
+        
+        # Configurar el mock de conexión para devolver un objeto con cursor
+        self.mock_cursor = MagicMock()
+        self.mock_conn = MagicMock()
+        self.mock_conn.cursor.return_value.__enter__.return_value = self.mock_cursor
+        self.mock_conexion.return_value.__enter__.return_value = self.mock_conn
+        
+        yield
+        
+        # Limpiar el mock después de cada test
+        self.patcher.stop()
+
+    def test_toggle_favorite_success(self):
+        # Configurar el mock para que devuelva éxito
+        self.mock_cursor.fetchone.return_value = None  # Usuario no existe inicialmente
+        self.mock_cursor.rowcount = 1  # Operación exitosa
+        
+        response = self.client.post("/favorites/toggle", json={
+            "user_id": 1,
+            "ad_id": 1
+        })
+        
+        assert response.status_code == 200
+        assert response.json() == {}
+
+    def test_toggle_favorite_user_not_found(self):
+        # Configurar el mock para simular que el usuario no existe
+        self.mock_cursor.fetchone.return_value = None  # Usuario no encontrado
+        
+        response = self.client.post("/favorites/toggle", json={
+            "user_id": 999,
+            "ad_id": 1
+        })
+        
+        assert response.status_code == 404
+        assert response.json() == {"error": "Usuario no encontrado"}
+
+    def test_list_favorites_success(self):
+        # Configurar el mock para devolver favoritos
+        self.mock_cursor.fetchall.return_value = [
+            {
+                "id": 1,
+                "ad_id": 1,
+                "favorited": True,
+                "status": "active"
+            }
+        ]
+        
+        response = self.client.get("/favorites/list", params={
+            "user_id": 1
+        })
+        
+        assert response.status_code == 200
+        assert response.json() == [
+            {
+                "id": 1,
+                "ad_id": 1,
+                "favorited": True,
+                "status": "active"
+            }
+        ]
+
+    def test_list_favorites_empty(self):
+        # Configurar el mock para devolver lista vacía
+        self.mock_cursor.fetchall.return_value = []
+        
+        response = self.client.get("/favorites/list", params={
+            "user_id": 1
+        })
+        
+        assert response.status_code == 200
+        assert response.json() == []
