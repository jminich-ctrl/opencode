+from fastapi import APIRouter
+from backend.app.servicios.favorites import toggle_favorite_service
+from backend.app.datos.favorites import get_user_favorites
+
+router = APIRouter()
+
+@router.post("/favorites/toggle")
+async def toggle_favorite_endpoint(user_id: int, ad_id: int):
+    """Endpoint que delega al servicio para marcar/desmarcar favorito."""
+    favorited = toggle_favorite_service(user_id, ad_id)
+    return {"status": "success", "favorited": favorited}
+
+@router.get("/favorites/list/{user_id}")
+async def list_user_favorites_endpoint(user_id: int):
+    """Endpoint que devuelve la lista de favoritos de un usuario."""
+    favorite_ids = get_user_favorites(user_id)
+    return {"favorite_ids": favorite_ids}
