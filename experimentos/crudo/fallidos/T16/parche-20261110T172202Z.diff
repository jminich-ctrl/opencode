+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+from backend.app.datos.favorites import toggle_favorite, get_user_favorites
+
+class TestFavoritesRutas:
+    
+    def test_toggle_favorite_endpoint(self):
+        """Prueba el endpoint de toggle favorito."""
+        with patch('backend.app.servicios.favorites.toggle_favorite_service') as mock_toggle:
+            mock_toggle.return_value = True
+            
+            client = TestClient(app)
+            response = client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 2})
+            
+            assert response.status_code == 200
+            assert response.json() == {"status": "success", "favorited": True}
+    
+    def test_list_user_favorites_endpoint(self):
+        """Prueba el endpoint de listar favoritos de un usuario."""
+        with patch('backend.app.datos.favorites.get_user_favorites') as mock_list:
+            mock_list.return_value = [1, 2]
+            
+            client = TestClient(app)
+            response = client.get("/favorites/list/1")
+            
+            assert response.status_code == 200
+            assert response.json() == {"favorite_ids": [1, 2]}
