+    @pytest.fixture(autouse=True)
+    def setup_method(self):
+        # Limpiar mocks antes de cada test
+        pass
+    
+    def test_toggle_favorite_success(self):
+        """Test que verifica el endpoint toggle favorito funciona correctamente"""
+        with patch('backend.app.datos.users.get_user_by_id') as mock_get_user:
+            with patch('backend.app.datos.favorites.toggle_favorite') as mock_toggle:
+                mock_get_user.return_value = {"id": 1, "email": "test@example.com"}
+                
+                response = client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 123})
+                
+                assert response.status_code == 200
+                assert response.json() == {}
+                mock_toggle.assert_called_once_with(1, 123)
+    
+    def test_toggle_favorite_user_not_found(self):
+        """Test que verifica el endpoint toggle favorito devuelve 404 si el usuario no existe"""
+        with patch('backend.app.datos.users.get_user_by_id') as mock_get_user:
+            mock_get_user.return_value = None
+            
+            response = client.post("/favorites/toggle", json={"user_id": 999, "ad_id": 123})
+            
+            assert response.status_code == 404
+            assert response.json() == {"detail": "Usuario no encontrado"}
+    
+    def test_list_favorites_success(self):
