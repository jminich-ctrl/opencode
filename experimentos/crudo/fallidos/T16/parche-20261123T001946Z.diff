+        with patch('backend.app.datos.users.get_user_by_id') as mock_get_user:
+            with patch('backend.app.datos.favorites.list_favorites') as mock_list:
+                mock_get_user.return_value = {"id": 1, "email": "test@example.com"}
+                mock_list.return_value = [
+                    {
+                        "id": 1,
+                        "ad_id": 123,
+                        "favorited": True,
+                        "status": "active"
+                    }
+                ]
+                
+                response = client.get("/favorites/list", params={"user_id": 1})
+                
+                assert response.status_code == 200
+                assert response.json() == {
+                    "favorites": [
+                        {
+                            "id": 1,
+                            "ad_id": 123,
+                            "favorited": True,
+                            "status": "active"
+                        }
+                    ]
+                }
+    
+    def test_list_favorites_user_not_found(self):
+        """Test que verifica el endpoint listar favoritos devuelve 404 si el usuario no existe"""
