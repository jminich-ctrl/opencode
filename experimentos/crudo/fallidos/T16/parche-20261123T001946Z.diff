@@ -0,0 +1,53 @@
+from fastapi import APIRouter, HTTPException
+from backend.app.datos.favorites import list_favorites
+from backend.app.servicios.favorites import toggle_favorite_service
+from backend.app.datos.conexion import conexion
+
+router = APIRouter()
+
+@router.post("/favorites/toggle")
+async def toggle_favorite_endpoint(user_id: int, ad_id: int):
+    """Endpoint que delega al servicio para marcar/desmarcar favorito.
+    Devuelve 200 OK con cuerpo vacío si la operación es exitosa.
+    Si el usuario no existe, devuelve 404.
+    """
+    # Verificar que el usuario exista
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT id FROM usuarios WHERE id = %s", (user_id,))
+            user = cur.fetchone()
+            if not user:
+                raise HTTPException(status_code=404, detail="Usuario no encontrado")
+    
+    # Llamar al servicio de favoritos
+    toggle_favorite_service(user_id, ad_id)
+    return {}
+
+@router.get("/favorites/list")
+async def list_favorites_endpoint(user_id: int):
+    """Endpoint que devuelve la lista de anuncios favoritos del usuario.
+    Devuelve 200 OK con un JSON que contiene una lista de objetos con las
+    claves: id, ad_id, favorited (bool) y status (str).
+    """
+    # Verificar que el usuario exista
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT id FROM usuarios WHERE id = %s", (user_id,))
+            user = cur.fetchone()
+            if not user:
+                raise HTTPException(status_code=404, detail="Usuario no encontrado")
+    
+    # Obtener los favoritos del usuario
+    favorites_list = list_favorites(user_id)
+    
+    # Formatear la respuesta según el contrato
+    result = []
+    for fav in favorites_list:
+        result.append({
+            "id": fav["id"],
+            "ad_id": fav["ad_id"],
+            "favorited": fav["favorited"],
+            "status": fav["status"]
+        })
+    
+    return {"favorites": result}
