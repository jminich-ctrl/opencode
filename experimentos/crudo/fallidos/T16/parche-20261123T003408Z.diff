+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+from backend.app.datos import conexion
+
+
+class TestFavoritesRutas:
+    @pytest.fixture(autouse=True)
+    def setup(self):
+        self.client = TestClient(app)
+        # Mockear la conexión a la base de datos
+        self.patcher = patch('backend.app.datos.conexion')
+        self.mock_conexion = self.patcher.start()
+        self.mock_cursor = MagicMock()
+        self.mock_conexion.return_value.__enter__.return_value.cursor.return_value = self.mock_cursor
+        
+        yield
+        
+        # Limpiar mocks después de cada test
+        self.patcher.stop()
+
+    def test_toggle_favorite_success(self):
+        # Configurar el mock para que devuelva un resultado exitoso
+        self.mock_cursor.fetchone.return_value = None  # Usuario no existe
+        
+        # Primero intentamos con un usuario que no existe
+        response = self.client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 1})
+        assert response.status_code == 404
+        
+        # Ahora configuramos que el usuario existe
+        self.mock_cursor.fetchone.return_value = {"id": 1}
+        self.mock_cursor.rowcount = 1
+        
+        response = self.client.post("/favorites/toggle", json={"user_id": 1, "ad_id": 1})
+        assert response.status_code == 200
+        assert response.json() == {}
+
+    def test_list_favorites_success(self):
+        # Configurar el mock para devolver resultados de favoritos
+        self.mock_cursor.fetchall.return_value = [
+            {
+                "id": 1,
+                "ad_id": 1,
+                "favorited": True,
+                "status": "active"
+            }
+        ]
+        
+        # Configurar que el usuario existe
+        self.mock_cursor.fetchone.return_value = {"id": 1}
+        
+        response = self.client.get("/favorites/list", params={"user_id": 1})
+        assert response.status_code == 200
+        assert isinstance(response.json(), list)
+        
+        # Verificar estructura del objeto devuelto
+        data = response.json()[0]
+        assert "id" in data
+        assert "ad_id" in data
+        assert "favorited" in data
+        assert "status" in data
+
+    def test_list_favorites_user_not_found(self):
+        # Configurar el mock para que el usuario no exista
+        self.mock_cursor.fetchone.return_value = None
+        
+        response = self.client.get("/favorites/list", params={"user_id": 999})
+        assert response.status_code == 404
