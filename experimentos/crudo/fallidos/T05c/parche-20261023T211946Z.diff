+from fastapi import APIRouter, HTTPException, Header
+from typing import List
+from pydantic import BaseModel
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.servicios.auth import usuario_desde_token
+
+router = APIRouter(prefix="/ads", tags=["ads"])
+
+class AdCreate(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+class AdUpdate(BaseModel):
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+class AdResponse(BaseModel):
+    id: int
+    usuario_id: int
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+class AdListResponse(BaseModel):
+    id: int
+    usuario_id: int
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+@router.post("/", response_model=dict, status_code=201)
+def crear_anuncio_endpoint(
+    ad_data: AdCreate,
+    authorization: str = Header(None)
+):
+    """Crea un nuevo anuncio."""
+    # Verificar autenticación
+    user_id = usuario_desde_token(authorization)
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Sesión no válida")
+    
+    try:
+        ad_id = crear_anuncio(
+            usuario_id=user_id,
+            categoria_id=ad_data.categoria_id,
+            titulo=ad_data.titulo,
+            descripcion=ad_data.descripcion,
+            precio_centavos=ad_data.precio_centavos
+        )
+        return {"id": ad_id}
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+@router.get("/", response_model=List[AdListResponse])
+def obtener_anuncios():
+    """Obtiene todos los anuncios."""
+    # Para esta implementación, simplemente devolvemos un error 501 ya que no hay implementación
+    # En una implementación real, necesitaríamos una función en el servicio para obtener todos los anuncios
+    raise HTTPException(status_code=501, detail="No implementado")
+
+@router.get("/{ad_id}", response_model=AdResponse)
+def obtener_anuncio_endpoint(ad_id: int):
+    """Obtiene un anuncio específico por ID."""
+    ad = obtener_anuncio(ad_id)
+    if ad is None:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return ad
+
+@router.put("/{ad_id}")
+def actualizar_anuncio_endpoint(
+    ad_id: int,
+    ad_data: AdUpdate,
+    authorization: str = Header(None)
+):
+    """Actualiza un anuncio existente."""
+    # Verificar autenticación
+    user_id = usuario_desde_token(authorization)
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Sesión no válida")
+    
+    try:
+        success = actualizar_anuncio(
+            ad_id=ad_id,
+            usuario_id=user_id,
+            titulo=ad_data.titulo,
+            descripcion=ad_data.descripcion,
+            precio_centavos=ad_data.precio_centavos
+        )
+        if not success:
+            raise HTTPException(status_code=403, detail="No tienes permisos para actualizar este anuncio")
+        return {"status": "success"}
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+
+@router.delete("/{ad_id}")
+def eliminar_anuncio_endpoint(
+    ad_id: int,
+    authorization: str = Header(None)
+):
+    """Elimina un anuncio existente."""
+    # Verificar autenticación
+    user_id = usuario_desde_token(authorization)
+    if user_id is None:
+        raise HTTPException(status_code=401, detail="Sesión no válida")
+    
+    try:
+        success = eliminar_anuncio(ad_id=ad_id, usuario_id=user_id)
+        if not success:
+            raise HTTPException(status_code=403, detail="No tienes permisos para eliminar este anuncio")
+        return {"status": "success"}
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
