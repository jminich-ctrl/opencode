+import pytest
+from unittest.mock import patch, MagicMock
+from fastapi.testclient import TestClient
+from backend.app.main import app
+from backend.app.rutas.ads import router
+
+# Creamos un cliente de prueba
+client = TestClient(app)
+
+class TestAdsRutas:
+    
+    def test_crear_anuncio(self):
+        """Prueba crear un nuevo anuncio"""
+        with patch('backend.app.servicios.ads.crear_anuncio') as mock_crear:
+            with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+                mock_auth.return_value = {"id": 1}
+                mock_crear.return_value = 123
+                
+                response = client.post(
+                    "/ads",
+                    json={
+                        "categoria_id": 1,
+                        "titulo": "Titulo de prueba",
+                        "descripcion": "Descripcion de prueba",
+                        "precio_centavos": 1000
+                    },
+                    headers={"Authorization": "Bearer token123"}
+                )
+                
+                assert response.status_code == 201
+                assert response.json() == {"id": 123}
+                mock_crear.assert_called_once_with(1, 1, "Titulo de prueba", "Descripcion de prueba", 1000)
+    
+    def test_listar_anuncios(self):
+        """Prueba listar todos los anuncios"""
+        with patch('backend.app.servicios.search.buscar_anuncios') as mock_buscar:
+            mock_buscar.return_value = [
+                {
+                    "id": 1,
+                    "usuario_id": 1,
+                    "titulo": "Anuncio 1",
+                    "categoria": "Electronica"
+                }
+            ]
+            
+            response = client.get("/ads")
+            
+            assert response.status_code == 200
+            assert response.json() == [
+                {
+                    "id": 1,
+                    "usuario_id": 1,
+                    "titulo": "Anuncio 1",
+                    "categoria": "Electronica"
+                }
+            ]
+    
+    def test_obtener_anuncio(self):
+        """Prueba obtener un anuncio específico"""
+        with patch('backend.app.servicios.ads.obtener_anuncio') as mock_obtener:
+            mock_obtener.return_value = {
+                "id": 1,
+                "usuario_id": 1,
+                "titulo": "Anuncio 1",
+                "descripcion": "Descripcion",
+                "precio_centavos": 1000,
+                "categoria": "Electronica"
+            }
+            
+            response = client.get("/ads/1")
+            
+            assert response.status_code == 200
+            assert response.json() == {
+                "id": 1,
+                "usuario_id": 1,
+                "titulo": "Anuncio 1",
+                "descripcion": "Descripcion",
+                "precio_centavos": 1000,
+                "categoria": "Electronica"
+            }
+    
+    def test_obtener_anuncio_no_existe(self):
+        """Prueba obtener un anuncio que no existe"""
+        with patch('backend.app.servicios.ads.obtener_anuncio') as mock_obtener:
+            mock_obtener.return_value = None
+            
+            response = client.get("/ads/999")
+            
+            assert response.status_code == 404
+    
+    def test_actualizar_anuncio(self):
+        """Prueba actualizar un anuncio existente"""
+        with patch('backend.app.servicios.ads.actualizar_anuncio') as mock_actualizar:
+            with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+                mock_auth.return_value = {"id": 1}
+                mock_actualizar.return_value = None
+                
+                response = client.put(
+                    "/ads/1",
+                    json={
+                        "categoria_id": 2,
+                        "titulo": "Titulo actualizado",
+                        "descripcion": "Descripcion actualizada",
+                        "precio_centavos": 2000
+                    },
+                    headers={"Authorization": "Bearer token123"}
+                )
+                
+                assert response.status_code == 200
+                mock_actualizar.assert_called_once_with(1, 1, "Titulo actualizado", "Descripcion actualizada", 2000)
+    
+    def test_eliminar_anuncio(self):
+        """Prueba eliminar un anuncio"""
+        with patch('backend.app.servicios.ads.eliminar_anuncio') as mock_eliminar:
+            with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+                mock_auth.return_value = {"id": 1}
+                mock_eliminar.return_value = None
+                
+                response = client.delete("/ads/1", headers={"Authorization": "Bearer token123"})
+                
+                assert response.status_code == 204
+                mock_eliminar.assert_called_once_with(1, 1)
+    
+    def test_crear_anuncio_sin_autenticacion(self):
+        """Prueba crear anuncio sin autenticación"""
+        with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+            mock_auth.return_value = None
+            
+            response = client.post(
+                "/ads",
+                json={
+                    "categoria_id": 1,
+                    "titulo": "Titulo de prueba",
+                    "descripcion": "Descripcion de prueba",
+                    "precio_centavos": 1000
+                },
+                headers={"Authorization": "Bearer token123"}
+            )
+            
+            assert response.status_code == 401
+    
+    def test_actualizar_anuncio_sin_autenticacion(self):
+        """Prueba actualizar anuncio sin autenticación"""
+        with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+            mock_auth.return_value = None
+            
+            response = client.put(
+                "/ads/1",
+                json={
+                    "categoria_id": 2,
+                    "titulo": "Titulo actualizado",
+                    "descripcion": "Descripcion actualizada",
+                    "precio_centavos": 2000
+                },
+                headers={"Authorization": "Bearer token123"}
+            )
+            
+            assert response.status_code == 401
+    
+    def test_eliminar_anuncio_sin_autenticacion(self):
+        """Prueba eliminar anuncio sin autenticación"""
+        with patch('backend.app.servicios.auth.usuario_desde_token') as mock_auth:
+            mock_auth.return_value = None
+            
+            response = client.delete("/ads/1", headers={"Authorization": "Bearer token123"})
+            
+            assert response.status_code == 401
