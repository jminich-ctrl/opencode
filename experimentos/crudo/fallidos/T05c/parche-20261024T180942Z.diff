+from fastapi import APIRouter, HTTPException, Header
+from pydantic import BaseModel
+from backend.app.servicios.auth import usuario_desde_token
+from backend.app.servicios.ads import (
+    crear_anuncio,
+    obtener_anuncio,
+    actualizar_anuncio,
+    eliminar_anuncio
+)
+from backend.app.servicios.search import buscar_anuncios
+
+router = APIRouter()
+
+# Modelo para crear anuncio
+class AnuncioCreate(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+# Modelo para actualizar anuncio
+class AnuncioUpdate(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+@router.post("/ads")
+def crear_anuncio_endpoint(
+    anuncio: AnuncioCreate,
+    authorization: str = Header(...),
+):
+    """Crear un nuevo anuncio"""
+    usuario = usuario_desde_token(authorization)
+    if not usuario:
+        raise HTTPException(status_code=401, detail="Sesión inválida")
+    
+    anuncio_id = crear_anuncio(
+        usuario["id"],
+        anuncio.categoria_id,
+        anuncio.titulo,
+        anuncio.descripcion,
+        anuncio.precio_centavos
+    )
+    
+    return {"id": anuncio_id}
+
+@router.get("/ads")
+def listar_anuncios():
+    """Listar todos los anuncios"""
+    anuncios = buscar_anuncios(None)
+    return anuncios
+
+@router.get("/ads/{id}")
+def obtener_anuncio_endpoint(id: int):
+    """Obtener un anuncio específico"""
+    anuncio = obtener_anuncio(id)
+    if not anuncio:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return anuncio
+
+@router.put("/ads/{id}")
+def actualizar_anuncio_endpoint(
+    id: int,
+    anuncio: AnuncioUpdate,
+    authorization: str = Header(...),
+):
+    """Actualizar un anuncio existente"""
+    usuario = usuario_desde_token(authorization)
+    if not usuario:
+        raise HTTPException(status_code=401, detail="Sesión inválida")
+    
+    # Verificar que el usuario sea el dueño del anuncio
+    # Esto se haría con una consulta a la base de datos para obtener el usuario_id del anuncio
+    # Por ahora asumimos que la función de servicio maneja esto
+    
+    actualizar_anuncio(
+        id,
+        usuario["id"],
+        anuncio.titulo,
+        anuncio.descripcion,
+        anuncio.precio_centavos
+    )
+    
+    return {}
+
+@router.delete("/ads/{id}")
+def eliminar_anuncio_endpoint(
+    id: int,
+    authorization: str = Header(...),
+):
+    """Eliminar un anuncio"""
+    usuario = usuario_desde_token(authorization)
+    if not usuario:
+        raise HTTPException(status_code=401, detail="Sesión inválida")
+    
+    # Verificar que el usuario sea el dueño del anuncio
+    # Esto se haría con una consulta a la base de datos para obtener el usuario_id del anuncio
+    # Por ahora asumimos que la función de servicio maneja esto
+    
+    eliminar_anuncio(id, usuario["id"])
+    
+    return {}
