+from fastapi import APIRouter, HTTPException, Depends
+from pydantic import BaseModel
+from typing import Optional
+from backend.app.servicios.auth import usuario_desde_token
+from backend.app.servicios.ads import (
+    crear_anuncio,
+    listar_anuncios,
+    obtener_anuncio,
+    actualizar_anuncio,
+    eliminar_anuncio
+)
+
+router = APIRouter()
+
+class AnuncioCreate(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+class AnuncioUpdate(BaseModel):
+    categoria_id: int
+    titulo: str
+    descripcion: str
+    precio_centavos: int
+
+@router.post("/ads")
+async def crear_anuncio_endpoint(
+    anuncio: AnuncioCreate,
+    usuario = Depends(usuario_desde_token)
+):
+    """Endpoint para crear un nuevo anuncio."""
+    # Verificar que el usuario esté autenticado
+    if usuario is None:
+        raise HTTPException(status_code=401, detail="Credenciales inválidas")
+    
+    try:
+        anuncio_id = crear_anuncio(
+            usuario,
+            anuncio.categoria_id,
+            anuncio.titulo,
+            anuncio.descripcion,
+            anuncio.precio_centavos
+        )
+        return {"id": anuncio_id}
+    except Exception as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+@router.get("/ads")
+async def listar_anuncios_endpoint(
+    usuario = Depends(usuario_desde_token)
+):
+    """Endpoint para listar todos los anuncios."""
+    # Verificar que el usuario esté autenticado
+    if usuario is None:
+        raise HTTPException(status_code=401, detail="Credenciales inválidas")
+    
+    anuncios = listar_anuncios()
+    return anuncios
+
+@router.get("/ads/{id}")
+async def obtener_anuncio_endpoint(
+    id: int,
+    usuario = Depends(usuario_desde_token)
+):
+    """Endpoint para obtener un anuncio específico."""
+    # Verificar que el usuario esté autenticado
+    if usuario is None:
+        raise HTTPException(status_code=401, detail="Credenciales inválidas")
+    
+    anuncio = obtener_anuncio(id)
+    if anuncio is None:
+        raise HTTPException(status_code=404, detail="Anuncio no encontrado")
+    return anuncio
+
+@router.put("/ads/{id}")
+async def actualizar_anuncio_endpoint(
+    id: int,
+    anuncio: AnuncioUpdate,
+    usuario = Depends(usuario_desde_token)
+):
+    """Endpoint para actualizar un anuncio existente."""
+    # Verificar que el usuario esté autenticado
+    if usuario is None:
+        raise HTTPException(status_code=401, detail="Credenciales inválidas")
+    
+    try:
+        actualizar_anuncio(
+            id,
+            usuario,
+            anuncio.titulo,
+            anuncio.descripcion,
+            anuncio.precio_centavos
+        )
+        return {}
+    except Exception as e:
+        if "No es tu aviso" in str(e):
+            raise HTTPException(status_code=403, detail="No es tu aviso")
+        raise HTTPException(status_code=400, detail=str(e))
+
+@router.delete("/ads/{id}")
+async def eliminar_anuncio_endpoint(
+    id: int,
+    usuario = Depends(usuario_desde_token)
+):
+    """Endpoint para eliminar un anuncio."""
+    # Verificar que el usuario esté autenticado
+    if usuario is None:
+        raise HTTPException(status_code=401, detail="Credenciales inválidas")
+    
+    try:
+        eliminar_anuncio(id, usuario)
+        return {}
+    except Exception as e:
+        if "No es tu aviso" in str(e):
+            raise HTTPException(status_code=403, detail="No es tu aviso")
+        raise HTTPException(status_code=400, detail=str(e))
