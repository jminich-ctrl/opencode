+from fastapi import APIRouter, HTTPException, Depends
+from typing import List, Dict, Any
+from backend.app.servicios.ads import crear_anuncio, obtener_anuncio, actualizar_anuncio, eliminar_anuncio
+from backend.app.servicios.auth import usuario_desde_token
+from backend.app.datos.ads import get_all_ads
+
+router = APIRouter()
+
+def get_current_user(token: str):
+    """Obtiene el usuario actual a partir del token"""
+    try:
+        return usuario_desde_token(token)
+    except Exception:
+        raise HTTPException(status_code=401, detail="Unauthorized")
+
+@router.post("/ads", status_code=201)
+async def create_ad(
+    categoria_id: int,
+    titulo: str,
+    descripcion: str,
+    precio_centavos: int,
+    token: str = Depends(get_current_user)
+):
+    """Crea un nuevo anuncio"""
+    try:
+        ad_id = crear_anuncio(token, categoria_id, titulo, descripcion, precio_centavos)
+        return {"id": ad_id}
+    except Exception as e:
+        # Manejar errores específicos
+        if "Forbidden" in str(e):
+            raise HTTPException(status_code=403, detail="Forbidden")
+        # Para otros errores, simplemente devolver 400
+        raise HTTPException(status_code=400, detail="Bad Request")
+
+@router.get("/ads", response_model=List[Dict[str, Any]])
+async def list_ads():
+    """Lista todos los anuncios"""
+    try:
+        ads = get_all_ads()
+        return ads
+    except Exception:
+        # Si ocurre algún error, retornamos lista vacía
+        return []
+
+@router.get("/ads/{id}", response_model=Dict[str, Any])
+async def get_ad(id: int, token: str = Depends(get_current_user)):
+    """Obtiene un anuncio específico por ID"""
+    try:
+        ad = obtener_anuncio(id)
+        if ad is None:
+            raise HTTPException(status_code=404, detail="Not Found")
+        return ad
+    except Exception:
+        raise HTTPException(status_code=404, detail="Not Found")
+
+@router.put("/ads/{id}")
+async def update_ad(
+    id: int,
+    categoria_id: int,
+    titulo: str,
+    descripcion: str,
+    precio_centavos: int,
+    token: str = Depends(get_current_user)
+):
+    """Actualiza un anuncio existente"""
+    try:
+        # Verificar que el usuario sea el dueño del anuncio
+        # Esto se haría con una función adicional que verifique el dueño
+        # Por ahora asumimos que el servicio manejará esto
+        actualizar_anuncio(id, token, categoria_id, titulo, descripcion, precio_centavos)
+        return {}
+    except Exception as e:
+        if "Forbidden" in str(e):
+            raise HTTPException(status_code=403, detail="Forbidden")
+        raise HTTPException(status_code=400, detail="Bad Request")
+
+@router.delete("/ads/{id}")
+async def delete_ad(id: int, token: str = Depends(get_current_user)):
+    """Elimina un anuncio"""
+    try:
+        # Verificar que el usuario sea el dueño del anuncio
+        # Esto se haría con una función adicional que verifique el dueño
+        # Por ahora asumimos que el servicio manejará esto
+        eliminar_anuncio(id, token)
+        return {}
+    except Exception as e:
+        if "Forbidden" in str(e):
+            raise HTTPException(status_code=403, detail="Forbidden")
+        raise HTTPException(status_code=400, detail="Bad Request")
