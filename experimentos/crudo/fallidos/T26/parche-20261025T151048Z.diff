+import pytest
+from unittest.mock import patch
+import hashlib
+from backend.app.servicios.register import crear_usuario
+
+
+class TestRegisterBackend:
+    def test_crear_usuario_ok(self):
+        """Debe crear un usuario con email y password, hashear la contraseña y devolver el ID"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        expected_hash = hashlib.sha256(password.encode()).hexdigest()
+        
+        # Mockear la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.return_value = 123
+            
+            # Act
+            result = crear_usuario(email, password)
+            
+            # Assert
+            assert result == 123
+            mock_insert.assert_called_once_with(email, expected_hash)
+    
+    def test_crear_usuario_validacion_email(self):
+        """Debe validar que el email tenga formato válido"""
+        # Arrange
+        email = "invalid-email"
+        password = "password123"
+        
+        # Act & Assert
+        with pytest.raises(ValueError, match="Email inválido"):
+            crear_usuario(email, password)
+    
+    def test_crear_usuario_validacion_password(self):
+        """Debe validar que la contraseña tenga al menos 8 caracteres"""
+        # Arrange
+        email = "test@example.com"
+        password = "123"
+        
+        # Act & Assert
+        with pytest.raises(ValueError, match="Contraseña inválida"):
+            crear_usuario(email, password)
+    
+    def test_crear_usuario_error_email_repetido(self):
+        """Debe lanzar un error cuando se intenta registrar un email que ya existe"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mockear la función de inserción para simular error de email duplicado
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Simular que la base de datos lanza un error de duplicado
+            from pymysql.err import IntegrityError
+            mock_insert.side_effect = IntegrityError(1062, "Duplicate entry 'test@example.com' for key 'usuarios.email'")
+            
+            # Act & Assert
+            with pytest.raises(Exception):
+                crear_usuario(email, password)
