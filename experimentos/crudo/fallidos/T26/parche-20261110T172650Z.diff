+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.servicios.register import crear_usuario
+from backend.app.datos.users_register import insert_user
+import hashlib
+
+
+class TestRegisterBackend:
+    def test_crear_usuario_ok(self):
+        """Prueba que se pueda crear un usuario correctamente"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mock de la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.return_value = 123
+            
+            # Act
+            result = crear_usuario(email, password)
+            
+            # Assert
+            assert result == 123
+            # El hash que se espera es el que se menciona en el enunciado
+            expected_hash = "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"
+            mock_insert.assert_called_once_with(email, expected_hash)
+
+    def test_crear_usuario_error_email_repetido(self):
+        """Prueba que se lance una excepción cuando se intenta registrar un email repetido"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mock de la función de inserción para simular error de email duplicado
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Simular que la base de datos lanza una excepción de duplicado
+            from pymysql.err import IntegrityError
+            mock_insert.side_effect = IntegrityError(1062, "Duplicate entry 'test@example.com' for key 'usuarios.email'")
+            
+            # Act & Assert
+            with pytest.raises(Exception) as excinfo:
+                crear_usuario(email, password)
+            
+            # Verificar que se lance una excepción de tipo adecuado
+            assert "Duplicate entry" in str(excinfo.value) or "1062" in str(excinfo.value)
