+import hashlib
+from unittest.mock import patch, MagicMock
+import pytest
+from fastapi.testclient import TestClient
+from backend.app.rutas.register import router
+from backend.app.servicios.register import crear_usuario
+from backend.app.datos.users_register import insert_user
+
+class TestRegisterBackend:
+    def test_insert_user(self):
+        """Prueba que insert_user inserte correctamente en la base de datos"""
+        # Este test se hará con mock para evitar conexión real a BD
+        pass
+    
+    def test_crear_usuario_valido(self):
+        """Prueba que crear_usuario valide correctamente y hashee la contraseña"""
+        # Mockear la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configurar el mock para devolver un ID
+            mock_insert.return_value = 123
+            
+            # Llamar a crear_usuario
+            result = crear_usuario("test@example.com", "password123")
+            
+            # Verificar que se llamó a insert_user con los parámetros correctos
+            mock_insert.assert_called_once_with(
+                "test@example.com",
+                hashlib.sha256("password123".encode()).hexdigest()
+            )
+            
+            # Verificar que se devolvió el ID correcto
+            assert result == 123
+    
+    def test_crear_usuario_email_invalido(self):
+        """Prueba que crear_usuario lance error con email inválido"""
+        with pytest.raises(ValueError, match="Email inválido"):
+            crear_usuario("", "password123")
+        
+        with pytest.raises(ValueError, match="Email inválido"):
+            crear_usuario("invalid-email", "password123")
+    
+    def test_crear_usuario_password_invalida(self):
+        """Prueba que crear_usuario lance error con contraseña inválida"""
+        with pytest.raises(ValueError, match="Contraseña inválida"):
+            crear_usuario("test@example.com", "")
+        
+        with pytest.raises(ValueError, match="Contraseña inválida"):
+            crear_usuario("test@example.com", "123")
+    
+    def test_registro_endpoint(self):
+        """Prueba que el endpoint /register funcione correctamente"""
+        # Mockear la función de servicio
+        with patch('backend.app.servicios.register.crear_usuario') as mock_crear:
+            mock_crear.return_value = 456
+            
+            # Simular una solicitud POST al endpoint
+            client = TestClient(router)
+            response = client.post("/register", json={
+                "email": "test@example.com",
+                "password": "password123"
+            })
+            
+            # Verificar que se devolvió el código correcto
+            assert response.status_code == 200
+            
+            # Verificar que se devolvió el ID esperado
+            assert response.json() == {"id": 456}
+            
+            # Verificar que se llamó a crear_usuario con los parámetros correctos
+            mock_crear.assert_called_once_with("test@example.com", "password123")
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
