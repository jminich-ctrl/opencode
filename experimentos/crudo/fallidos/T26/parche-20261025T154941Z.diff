+import pytest
+from unittest.mock import patch, MagicMock
+from backend.app.servicios.register import crear_usuario
+import hashlib
+
+
+class TestRegisterBackend:
+    def test_registro_usuario_exitoso(self):
+        """Prueba que se pueda registrar un usuario exitosamente"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        expected_hash = hashlib.sha256(password.encode()).hexdigest()
+        
+        # Mock de la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.return_value = 123
+            
+            # Act
+            result = crear_usuario(email, password)
+            
+            # Assert
+            assert result == 123
+            mock_insert.assert_called_once_with(email, expected_hash)
+
+    def test_registro_usuario_email_repetido(self):
+        """Prueba que se lance una excepción cuando se intenta registrar un email que ya existe"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mock de la función de inserción para simular que el email ya existe
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.side_effect = Exception("Email already exists")
+            
+            # Act & Assert
+            with pytest.raises(Exception) as exc_info:
+                crear_usuario(email, password)
+            
+            assert "Email already exists" in str(exc_info.value)
