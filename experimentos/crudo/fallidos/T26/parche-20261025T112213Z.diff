+import hashlib
+from unittest.mock import patch
+from backend.app.servicios.register import crear_usuario
+from backend.app.datos.users_register import insert_user
+
+class TestRegisterBackend:
+    def test_crear_usuario_ok(self):
+        """Prueba que se pueda crear un usuario correctamente."""
+        # Mockear la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configurar el mock para devolver un ID
+            mock_insert.return_value = 123
+            
+            # Llamar a la función
+            result = crear_usuario("test@example.com", "password123")
+            
+            # Verificar que se llamó a la función con los parámetros correctos
+            # El mock espera 2 parámetros: email y password_hash (como en el test)
+            mock_insert.assert_called_once_with(
+                "test@example.com",
+                hashlib.sha256("password123".encode()).hexdigest()
+            )
+            
+            # Verificar que se devolvió el ID correcto
+            assert result == 123
+    
+    def test_crear_usuario_email_invalido(self):
+        """Prueba que se lance un error al crear un usuario con email inválido."""
+        # Intentar crear un usuario con email vacío
+        try:
+            crear_usuario("", "password123")
+            assert False, "Debería haber lanzado un ValueError"
+        except ValueError:
+            pass  # Esto está bien
+    
+    def test_crear_usuario_password_invalida(self):
+        """Prueba que se lance un error al crear un usuario con contraseña inválida."""
+        # Intentar crear un usuario con contraseña vacía
+        try:
+            crear_usuario("test@example.com", "")
+            assert False, "Debería haber lanzado un ValueError"
+        except ValueError:
+            pass  # Esto está bien
+    
+    def test_crear_usuario_hash_correcto(self):
+        """Prueba que se calcule correctamente el hash de la contraseña."""
+        # Mockear la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configurar el mock para devolver un ID
+            mock_insert.return_value = 123
+            
+            # Llamar a la función
+            crear_usuario("test@example.com", "password123")
+            
+            # Verificar que se llamó con el hash correcto
+            expected_hash = hashlib.sha256("password123".encode()).hexdigest()
+            mock_insert.assert_called_once()
+            args, kwargs = mock_insert.call_args
+            assert args[1] == expected_hash
