+import pytest
+from unittest.mock import patch
+from backend.app.rutas.register import router
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+# Agregar el router de registro a la aplicación principal para los tests
+app.include_router(router, prefix="")
+
+client = TestClient(app)
+
+class TestRegisterBackend:
+    def test_registro_usuario_exitoso(self):
+        """Prueba que se pueda registrar un usuario exitosamente."""
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configurar el mock para devolver un ID
+            mock_insert.return_value = 123
+            
+            # Hacer la solicitud de registro
+            response = client.post("/register", json={
+                "email": "test@example.com",
+                "password": "password123"
+            })
+            
+            # Verificar que la respuesta sea correcta
+            assert response.status_code == 200
+            assert response.json() == {"id": 123}
+            
+            # Verificar que se llamó a insert_user con los parámetros correctos
+            mock_insert.assert_called_once_with(
+                "test@example.com",
+                "5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8"  # sha256 de "password123"
+            )
+
+    def test_registro_usuario_email_invalido(self):
+        """Prueba que se rechace un registro con email inválido."""
+        response = client.post("/register", json={
+            "email": "invalid-email",
+            "password": "password123"
+        })
+        
+        assert response.status_code == 400
+        assert "Email inválido" in response.json()["error"]
+
+    def test_registro_usuario_contrasena_corta(self):
+        """Prueba que se rechace un registro con contraseña muy corta."""
+        response = client.post("/register", json={
+            "email": "test@example.com",
+            "password": "123"
+        })
+        
+        assert response.status_code == 400
+        assert "Contraseña inválida" in response.json()["error"]
