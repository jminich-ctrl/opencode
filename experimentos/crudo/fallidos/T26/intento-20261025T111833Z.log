import hashlib
from backend.app.datos.conexion import conexion

def insert_user(email: str, password_hash: str) -> int:
    """Inserta la fila y devuelve el id nuevo. Lanza si el email ya existe.
    Recibe el hash YA calculado: el hasheo es del servicio, no de la capa de datos."""
    with conexion() as conn:
        with conn.cursor() as cur:
            cur.execute(
                "INSERT INTO usuarios (email, password_hash) VALUES (%s, %s)",
                (email, password_hash)
            )
            return cur.lastrowid
=== register.py (servicios) ===
import hashlib
from backend.app.datos.users_register import insert_user

def crear_usuario(email: str, password: str) -> int:
    """Valida, hashea con el mismo esquema que `auth.py` y delega en
    `users_register.insert_user`. Devuelve el id."""
    # Validar datos básicos
    if not email or not isinstance(email, str) or "@" not in email:
        raise ValueError("Email inválido")
    
    if not password or not isinstance(password, str) or len(password) < 6:
        raise ValueError("Contraseña inválida")
    
    # Hashear contraseña usando el mismo esquema que auth.py
    password_hash = hashlib.sha256(password.encode()).hexdigest()
    
    # Insertar usuario
    return insert_user(email, password_hash)
=== register.py (rutas) ===
from fastapi import APIRouter, HTTPException
from pydantic import BaseModel
from backend.app.servicios.register import crear_usuario

router = APIRouter()

class RegisterRequest(BaseModel):
    email: str
    password: str

@router.post("/register")
def register(request: RegisterRequest):
    """Crea un nuevo usuario."""
    try:
        user_id = crear_usuario(request.email, request.password)
        return {"id": user_id}
    except ValueError as e:
        raise HTTPException(400, str(e))
    except Exception:
        raise HTTPException(500, "Error interno del servidor")
