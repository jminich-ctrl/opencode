=== users_register.py ===
import hashlib
from .conexion import conexion

def insert_user(email: str, password_hash: str, password_salt: str) -> int:
    """Inserta la fila y devuelve el id nuevo. Lanza si el email ya existe.
    Recibe el hash YA calculado: el hasheo es del servicio, no de la capa de datos."""
    with conexion() as conn:
        with conn.cursor() as cur:
            cur.execute(
                "INSERT INTO usuarios (email, clave_hash, clave_salt) VALUES (%s, %s, %s)",
                (email, password_hash, password_salt)
            )
            return cur.lastrowid
=== register.py (servicios) ===
import hashlib
from ..datos.users_register import insert_user

def crear_usuario(email: str, password: str) -> int:
    """Valida, hashea con el mismo esquema que `auth.py` y delega en
    `users_register.insert_user`. Devuelve el id."""
    # Validación básica
    if not email or not isinstance(email, str):
        raise ValueError("Email inválido")
    
    if not password or not isinstance(password, str):
        raise ValueError("Contraseña inválida")
    
    # Hashear contraseña con el mismo esquema que auth.py
    password_hash = hashlib.sha256(password.encode()).hexdigest()
    # Para este caso, vamos a usar un salt fijo como en el ejemplo
    # En producción debería ser un salt aleatorio
    password_salt = "fixed_salt_for_testing"
    
    # Insertar usuario
    return insert_user(email, password_hash, password_salt)
=== register.py (rutas) ===
from fastapi import APIRouter, HTTPException
from ..servicios.register import crear_usuario

router = APIRouter()

@router.post("/register")
def register(email: str, password: str):
    """Crea un nuevo usuario con los datos proporcionados."""
    try:
        user_id = crear_usuario(email, password)
        return {"id": user_id}
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        # Manejo genérico de errores de base de datos
        raise HTTPException(status_code=500, detail="Error al crear usuario")
