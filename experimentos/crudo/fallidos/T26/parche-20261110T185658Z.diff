+import hashlib
+import pytest
+from unittest.mock import patch
+from backend.app.servicios.register import crear_usuario
+
+
+class TestRegisterBackend:
+    def test_crear_usuario_ok(self):
+        """Debe crear un usuario con email y contraseña hasheada"""
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mockear la función de inserción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.return_value = 123
+            
+            # Llamar al servicio
+            user_id = crear_usuario(email, password)
+            
+            # Verificar que se llamó correctamente
+            mock_insert.assert_called_once_with(
+                email, 
+                hashlib.sha256(password.encode()).hexdigest()
+            )
+            assert user_id == 123
+    
+    def test_crear_usuario_error_email_repetido(self):
+        """Debe lanzar excepción cuando el email ya existe"""
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mockear la función de inserción para simular error de email duplicado
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Simular que la base de datos lanza un error de duplicado
+            from pymysql.err import IntegrityError
+            mock_insert.side_effect = IntegrityError(1062, "Duplicate entry 'test@example.com' for key 'usuarios.email'")
+            
+            # Verificar que se lanza la excepción
+            try:
+                crear_usuario(email, password)
+                assert False, "Debería haber lanzado una excepción"
+            except IntegrityError as e:
+                assert "Duplicate entry" in str(e)
+            except Exception as e:
+                # Si se lanza otra excepción, verificar que es la esperada
+                assert "Duplicate entry" in str(e)
