+import hashlib
+from unittest.mock import patch
+import pytest
+from backend.app.servicios.register import crear_usuario
+
+class TestRegisterBackend:
+    def test_crear_usuario_hashea_con_sha256(self):
+        """El servicio debe hashear la contraseña con sha256, como hace login"""
+        # Mockear la función de inserción para evitar acceso a BD
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configurar el mock para devolver un ID fijo
+            mock_insert.return_value = 123
+            
+            # Llamar al servicio
+            result = crear_usuario("test@example.com", "password123")
+            
+            # Verificar que se llamó a insert_user con el hash correcto
+            expected_hash = hashlib.sha256("password123".encode()).hexdigest()
+            mock_insert.assert_called_once_with("test@example.com", expected_hash)
+            
+            # Verificar que se devolvió el ID correcto
+            assert result == 123
+    
+    def test_registro_valida_datos(self):
+        """El servicio debe validar los datos de entrada"""
+        # Prueba con email inválido
+        with pytest.raises(ValueError, match="Email inválido"):
+            crear_usuario("", "password123")
+        
+        # Prueba con contraseña inválida
+        with pytest.raises(ValueError, match="Contraseña inválida"):
+            crear_usuario("test@example.com", "")
