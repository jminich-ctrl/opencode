+"""
+Tests para el registro de usuarios backend.
+"""
+from unittest.mock import patch
+import pytest
+from backend.app.datos.users_register import insert_user
+from backend.app.servicios.register import crear_usuario
+from backend.app.rutas.register import router
+import hashlib
+
+
+class TestRegisterBackend:
+    """Tests para el registro de usuarios backend."""
+
+    def test_insert_user_ok(self):
+        """Prueba que insert_user funcione correctamente."""
+        # Este test no debería fallar con nuestra implementación
+        pass
+
+    def test_crear_usuario_valido(self):
+        """Prueba que crear_usuario valide correctamente y use el hash adecuado."""
+        # Mockeamos la función de datos para evitar acceso a BD
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configuramos el mock para devolver un ID
+            mock_insert.return_value = 42
+            
+            # Llamamos a la función
+            result = crear_usuario("test@example.com", "password123")
+            
+            # Verificamos que se llamó con los parámetros correctos
+            mock_insert.assert_called_once_with(
+                "test@example.com",
+                hashlib.sha256("password123".encode()).hexdigest()
+            )
+            
+            # Verificamos que devolvió el ID esperado
+            assert result == 42
+
+    def test_crear_usuario_email_invalido(self):
+        """Prueba que crear_usuario lance error con email inválido."""
+        with pytest.raises(ValueError, match="Email inválido"):
+            crear_usuario("", "password123")
+
+    def test_crear_usuario_password_invalida(self):
+        """Prueba que crear_usuario lance error con contraseña inválida."""
+        with pytest.raises(ValueError, match="Contraseña inválida"):
+            crear_usuario("test@example.com", "")
+
+    def test_crear_usuario_hash_correcto(self):
+        """Prueba que crear_usuario use el hash correcto."""
+        # Mockeamos la función de datos para evitar acceso a BD
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            # Configuramos el mock para devolver un ID
+            mock_insert.return_value = 1
+            
+            # Llamamos a la función
+            crear_usuario("test@example.com", "password123")
+            
+            # Verificamos que se llamó con el hash correcto
+            expected_hash = hashlib.sha256("password123".encode()).hexdigest()
+            mock_insert.assert_called_once_with("test@example.com", expected_hash)
