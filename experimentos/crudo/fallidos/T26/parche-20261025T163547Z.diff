+import hashlib
+import pytest
+from unittest.mock import patch
+from fastapi import HTTPException
+from backend.app.servicios.register import crear_usuario
+from backend.app.datos.users_register import insert_user
+
+
+class TestRegisterBackend:
+    def test_registro_usuario_ok(self):
+        """El usuario se registra correctamente con hash de contraseña"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mockear la función de inserción en la base de datos
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.return_value = 123
+            
+            # Act
+            result = crear_usuario(email, password)
+            
+            # Assert
+            assert result == 123
+            mock_insert.assert_called_once_with(
+                email, 
+                hashlib.sha256(password.encode()).hexdigest()
+            )
+    
+    def test_registro_usuario_email_repetido(self):
+        """Al registrar un email repetido, se lanza una excepción HTTP 409"""
+        # Arrange
+        email = "test@example.com"
+        password = "password123"
+        
+        # Mockear la función de inserción en la base de datos para lanzar excepción
+        with patch('backend.app.datos.users_register.insert_user') as mock_insert:
+            mock_insert.side_effect = Exception("Email already exists")
+            
+            # Act & Assert
+            with pytest.raises(HTTPException) as exc_info:
+                crear_usuario(email, password)
+            
+            # Assert
+            assert exc_info.value.status_code == 409
