+            # Configurar el mock con datos de usuario
+            mock_user = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+            }
+            mock_read_user.return_value = mock_user
+            
+            # Hacer llamada al endpoint
+            response = client.post("/auth/login", json={
+                "email": "test@example.com",
+                "password": "password"
+            })
+            
+            # Verificar que se devuelve 200 y un token
+            assert response.status_code == 200
+            data = response.json()
+            assert 'token' in data
+            assert data['token'] == 'token-1'
+    
+    def test_api_login_wrong_password(self):
+        """Test endpoint API login con contraseña incorrecta."""
+        client = TestClient(app)
+        
+        # Mockear la función de lectura de usuario
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            # Configurar el mock con datos de usuario
+            mock_user = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+            }
+            mock_read_user.return_value = mock_user
+            
+            # Hacer llamada al endpoint con contraseña incorrecta
+            response = client.post("/auth/login", json={
+                "email": "test@example.com",
+                "password": "wrongpassword"
+            })
+            
+            # Verificar que se devuelve 401
+            assert response.status_code == 401
