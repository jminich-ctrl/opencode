+"""
+Capa de datos para usuarios.
+"""
+from backend.app.datos.conexion import conexion
+
+
+def read_user_by_email(email: str) -> dict | None:
+    """
+    Lee un usuario por email.
+    
+    Args:
+        email: El email del usuario a buscar
+        
+    Returns:
+        Dict con los datos del usuario o None si no existe
+    """
+    with conexion() as conn:
+        with conn.cursor() as cur:
+            cur.execute("SELECT id, email, password_hash FROM users WHERE email = %s", (email,))
+            fila = cur.fetchone()
+            if fila:
+                return {
+                    'id': fila['id'],
+                    'email': fila['email'], 
+                    'password_hash': fila['password_hash']
+                }
+            return None
