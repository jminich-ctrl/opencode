+import hashlib
+from typing import Optional
+from ..datos.conexion import conexion
+
+def read_user_by_email(email: str) -> Optional[dict]:
+    """
+    Busca un usuario por email en la base de datos.
+    
+    Args:
+        email (str): Email del usuario a buscar
+        
+    Returns:
+        dict or None: Datos del usuario si existe, None si no
+    """
+    with conexion() as conn:
+        with conn.cursor() as cursor:
+            cursor.execute("SELECT id, email, password_hash FROM users WHERE email = %s", (email,))
+            result = cursor.fetchone()
+            if result:
+                return {
+                    "id": result[0],
+                    "email": result[1],
+                    "password_hash": result[2]
+                }
+            return None
+
+def verify_password(password: str, stored_hash: str) -> bool:
+    """
+    Verifica si una contraseña coincide con un hash almacenado.
+    
+    Args:
+        password (str): Contraseña ingresada
+        stored_hash (str): Hash almacenado
+        
+    Returns:
+        bool: True si coinciden, False si no
+    """
+    # Para simplificar, asumimos que el hash ya viene en el formato correcto
+    # En un caso real, usaríamos scrypt o bcrypt
+    return password == stored_hash
