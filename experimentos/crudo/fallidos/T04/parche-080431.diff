+from fastapi import APIRouter, Request, Response, HTTPException, status
+from ..servicios.auth import login as authenticate_user
+import secrets
+
+router = APIRouter(prefix="/auth")
+
+@router.post("/login")
+def login(request: Request) -> Response:
+    """
+    Valida credenciales y devuelve respuesta con cookie de sesión.
+    
+    Args:
+        request (Request): Objeto de solicitud FastAPI
+        
+    Returns:
+        Response: Respuesta con cookie de sesión httpOnly
+        
+    Raises:
+        HTTPException: Si las credenciales son inválidas
+    """
+    # Obtener datos del body
+    try:
+        body = request.json()
+        email = body.get("email")
+        password = body.get("password")
+    except Exception:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Formato de datos inválido"
+        )
+    
+    if not email or not password:
+        raise HTTPException(
+            status_code=status.HTTP_400_BAD_REQUEST,
+            detail="Email y contraseña son requeridos"
+        )
+    
+    # Autenticar usuario
+    try:
+        user = authenticate_user(email, password)
+    except HTTPException as e:
+        # Re-lanzar excepción HTTP de autenticación
+        raise e
+    
+    # Generar token de sesión
+    session_token = secrets.token_urlsafe(32)
+    
+    # Crear respuesta con cookie
+    response = Response()
+    response.set_cookie(
+        key="session_token",
+        value=session_token,
+        httponly=True,
+        secure=True,
+        samesite="strict",
+        max_age=3600  # 1 hora
+    )
+    
+    return response
+
+@router.post("/logout")
+def logout(response: Response) -> Response:
+    """
+    Elimina la cookie de sesión para cerrar sesión.
+    
+    Args:
+        response (Response): Objeto de respuesta FastAPI
+        
+    Returns:
+        Response: Respuesta con cookie de sesión eliminada
+    """
+    response.delete_cookie(key="session_token")
+    return response
