+"""
+Servicios de autenticación.
+"""
+
+import hashlib
+from backend.app.datos import users
+
+
+def login(email: str, password: str) -> dict | None:
+    """
+    Verifica credenciales de usuario.
+    
+    Args:
+        email: El email del usuario
+        password: La contraseña en texto plano
+        
+    Returns:
+        Dict con `token` si las credenciales son válidas, o None si no
+    """
+    # Buscar al usuario
+    user = users.read_user_by_email(email)
+    if not user:
+        return None
+    
+    # Verificar contraseña
+    # El hash es sha256 del password, sin sal
+    expected_hash = hashlib.sha256(password.encode()).hexdigest()
+    if user['password_hash'] == expected_hash:
+        # En una implementación real, aquí se generarían tokens JWT o similares
+        # Por ahora, devolvemos un token dummy
+        return {'token': 'dummy-token-for-' + email}
+    
+    return None
