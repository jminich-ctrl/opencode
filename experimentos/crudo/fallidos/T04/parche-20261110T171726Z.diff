+"""
+Tests para la autenticación backend.
+"""
+
+import hashlib
+from unittest.mock import patch
+from backend.app.datos import users
+from backend.app.servicios.auth import login
+from backend.app.rutas.auth import router
+import pytest
+from fastapi.testclient import TestClient
+from fastapi import FastAPI
+
+
+class TestAuthBackend:
+    """Tests para la autenticación backend."""
+
+    def test_login_con_credenciales_validas(self):
+        """Debe devolver un token con credenciales válidas."""
+        # Mockear el usuario con un hash calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            result = login('test@example.com', 'password')
+            
+            assert result is not None
+            assert 'token' in result
+
+    def test_login_con_password_incorrecto(self):
+        """Debe devolver None con password incorrecto."""
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            result = login('test@example.com', 'wrongpassword')
+            
+            assert result is None
+
+    def test_login_con_usuario_inexistente(self):
+        """Debe devolver None con usuario inexistente."""
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = None
+            
+            result = login('nonexistent@example.com', 'password')
+            
+            assert result is None
+
+    def test_endpoint_login_con_credenciales_validas(self):
+        """El endpoint debe devolver 200 y un token con credenciales válidas."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        # Mockear el usuario con un hash calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            response = client.post("/auth/login", json={
+                "email": "test@example.com",
+                "password": "password"
+            })
+            
+            assert response.status_code == 200
+            data = response.json()
+            assert 'token' in data
+
+    def test_endpoint_login_con_password_incorrecto(self):
+        """El endpoint debe devolver 401 con password incorrecto."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        # Mockear el usuario con un hash calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            response = client.post("/auth/login", json={
+                "email": "test@example.com",
+                "password": "wrongpassword"
+            })
+            
+            assert response.status_code == 401
+
+    def test_endpoint_login_con_usuario_inexistente(self):
+        """El endpoint debe devolver 401 con usuario inexistente."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = None
+            
+            response = client.post("/auth/login", json={
+                "email": "nonexistent@example.com",
+                "password": "password"
+            })
+            
+            assert response.status_code == 401
