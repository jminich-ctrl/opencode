+"""
+Tests para la autenticación backend.
+"""
+
+import hashlib
+from unittest.mock import patch
+from backend.app.datos import users
+from backend.app.servicios.auth import login
+from backend.app.rutas.auth import router
+import pytest
+from fastapi.testclient import TestClient
+from fastapi import FastAPI
+
+
+class TestAuthBackend:
+    """Tests para la autenticación backend."""
+
+    def test_login_valid_credentials(self):
+        """Test de login con credenciales válidas."""
+        # Mockear el usuario con un hash de contraseña calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            result = login('test@example.com', 'password')
+            
+            assert result is not None
+            assert 'token' in result
+            assert result['token'] == 'dummy-token-for-test@example.com'
+
+    def test_login_invalid_password(self):
+        """Test de login con contraseña incorrecta."""
+        # Mockear el usuario con un hash de contraseña calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            result = login('test@example.com', 'wrongpassword')
+            
+            assert result is None
+
+    def test_login_nonexistent_user(self):
+        """Test de login con usuario inexistente."""
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = None
+            
+            result = login('nonexistent@example.com', 'password')
+            
+            assert result is None
+
+    def test_auth_endpoint_success(self):
+        """Test del endpoint POST /auth/login con credenciales válidas."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        # Mockear el usuario con un hash de contraseña calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            response = client.post(
+                "/auth/login",
+                json={
+                    "email": "test@example.com",
+                    "password": "password"
+                }
+            )
+            
+            assert response.status_code == 200
+            data = response.json()
+            assert 'token' in data
+
+    def test_auth_endpoint_invalid_password(self):
+        """Test del endpoint POST /auth/login con contraseña incorrecta."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        # Mockear el usuario con un hash de contraseña calculado
+        mock_user = {
+            'id': 1,
+            'email': 'test@example.com',
+            'password_hash': hashlib.sha256('password'.encode()).hexdigest()
+        }
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = mock_user
+            
+            response = client.post(
+                "/auth/login",
+                json={
+                    "email": "test@example.com",
+                    "password": "wrongpassword"
+                }
+            )
+            
+            assert response.status_code == 401
+
+    def test_auth_endpoint_nonexistent_user(self):
+        """Test del endpoint POST /auth/login con usuario inexistente."""
+        app = FastAPI()
+        app.include_router(router)
+        client = TestClient(app)
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read:
+            mock_read.return_value = None
+            
+            response = client.post(
+                "/auth/login",
+                json={
+                    "email": "nonexistent@example.com",
+                    "password": "password"
+                }
+            )
+            
+            assert response.status_code == 401
