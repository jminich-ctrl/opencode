+"""
+Servicios de autenticación.
+"""
+
+import hashlib
+from backend.app.datos import users
+
+
+def login(email: str, password: str) -> dict | None:
+    """
+    Verifica credenciales de usuario.
+    
+    Args:
+        email: El email del usuario
+        password: La contraseña en texto plano
+        
+    Returns:
+        Dict con `token` si las credenciales son válidas, o None si no
+    """
+    # Obtener el usuario
+    user = users.read_user_by_email(email)
+    if not user:
+        return None
+    
+    # Calcular el hash de la contraseña proporcionada
+    password_hash = hashlib.sha256(password.encode()).hexdigest()
+    
+    # Comparar hashes
+    if password_hash == user['password_hash']:
+        # En una implementación real, aquí se generarían un token JWT o similar
+        # Por ahora, retornamos un token dummy
+        return {'token': 'dummy-token-for-' + email}
+    
+    return None
