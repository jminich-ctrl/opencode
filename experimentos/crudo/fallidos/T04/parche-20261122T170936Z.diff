+import hashlib
+from unittest.mock import patch
+from backend.app.servicios.auth import login
+import pytest
+from fastapi.testclient import TestClient
+from backend.app.main import app
+
+# Test del servicio auth
+class TestAuthBackend:
+    def test_login_valid_credentials(self):
+        """Con credenciales válidas devuelve un token."""
+        # Mockear la función read_user_by_email para devolver un usuario con hash válido
+        hashed_password = hashlib.sha256('password'.encode()).hexdigest()
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashed_password
+            }
+            
+            result = login('test@example.com', 'password')
+            
+            assert result is not None
+            assert 'token' in result
+            
+    def test_login_invalid_password(self):
+        """Con password incorrecto devuelve None."""
+        hashed_password = hashlib.sha256('password'.encode()).hexdigest()
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashed_password
+            }
+            
+            result = login('test@example.com', 'wrongpassword')
+            
+            assert result is None
+            
+    def test_login_nonexistent_user(self):
+        """Con usuario inexistente devuelve None."""
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = None
+            
+            result = login('nonexistent@example.com', 'password')
+            
+            assert result is None
+
+# Test del endpoint
+class TestAuthEndpoint:
+    def test_login_endpoint_success(self):
+        """POST /auth/login con credenciales válidas devuelve 200 y un token."""
+        client = TestClient(app)
+        
+        # Mockear la función read_user_by_email para devolver un usuario con hash válido
+        hashed_password = hashlib.sha256('password'.encode()).hexdigest()
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashed_password
+            }
+            
+            response = client.post("/auth/login", json={"email": "test@example.com", "password": "password"})
+            
+            assert response.status_code == 200
+            data = response.json()
+            assert "token" in data
+            
+    def test_login_endpoint_invalid_password(self):
+        """POST /auth/login con password incorrecto devuelve 401."""
+        client = TestClient(app)
+        
+        # Mockear la función read_user_by_email para devolver un usuario con hash válido
+        hashed_password = hashlib.sha256('password'.encode()).hexdigest()
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = {
+                'id': 1,
+                'email': 'test@example.com',
+                'password_hash': hashed_password
+            }
+            
+            response = client.post("/auth/login", json={"email": "test@example.com", "password": "wrongpassword"})
+            
+            assert response.status_code == 401
+            
+    def test_login_endpoint_nonexistent_user(self):
+        """POST /auth/login con usuario inexistente devuelve 401."""
+        client = TestClient(app)
+        
+        with patch('backend.app.datos.users.read_user_by_email') as mock_read_user:
+            mock_read_user.return_value = None
+            
+            response = client.post("/auth/login", json={"email": "nonexistent@example.com", "password": "password"})
+            
+            assert response.status_code == 401
