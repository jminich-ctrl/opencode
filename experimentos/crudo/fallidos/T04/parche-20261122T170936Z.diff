+import hashlib
+import backend.app.datos.users as users
+
+def login(email: str, password: str) -> dict | None:
+    """Verifica credenciales. Devuelve algo con `token` si son válidas, o None."""
+    # Obtener el usuario por email
+    user = users.read_user_by_email(email)
+    
+    if user is None:
+        return None
+    
+    # Calcular el hash del password proporcionado
+    password_hash = hashlib.sha256(password.encode()).hexdigest()
+    
+    # Comparar el hash calculado con el almacenado
+    if password_hash == user.get("password_hash"):
+        # En una implementación real, aquí se generarían un token JWT o similar
+        # Por ahora retornamos un diccionario con un token dummy
+        return {"token": "dummy-token-for-testing"}
+    
+    return None
