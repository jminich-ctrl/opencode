```python
import pytest
from fastapi.testclient import TestClient

from app.main import app


class TestApp:
    def test_app_es_instancia_de_fastapi(self):
        """Verifica que `app` sea una instancia de FastAPI."""
        from fastapi import FastAPI
        assert isinstance(app, FastAPI)

    def test_salud_responde_200(self):
        """Verifica que GET /salud responda 200."""
        client = TestClient(app)
        response = client.get("/salud")
        assert response.status_code == 200

    def test_salud_devuelve_estado_ok(self):
        """Verifica que GET /salud devuelva {"estado": "ok"}."""
        client = TestClient(app)
        response = client.get("/salud")
        assert response.json() == {"estado": "ok"}
```

