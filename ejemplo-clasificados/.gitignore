.entorno
.mysql/

# Entornos que un agente perdido puede crear con otro nombre. `.venv` ya estaba; esto
# apareció cuando un arquitecto se puso a explorar y dejó `venv/` sin punto: 1923 archivos
# y 695.000 líneas entraron en un commit mío con `git add -A`.
venv/
pytest-install/
*-install/

# Intermedios de replanificar.sh y replanificar-relevo.sh: el diagnóstico que levanta
# del transcript y el cuerpo que escribe el segundo agente. Son insumos de una corrida,
# no entregables del proyecto.
.diagnostico-*.md
.replan-*.md
.replan-*.log
.relevo-*.log
