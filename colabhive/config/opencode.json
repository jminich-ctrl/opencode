      "permission": {
        "edit": "deny",
        "bash": "ask"
      },
      "tools": {
        "webfetch": false,
        "skill": false,
        "task": false,
        "todowrite": false
      }
    },
    "tester": {
      "mode": "subagent",
      "model": "colabhive/f5d76140-5b4d-41c0-88da-dad6d11f341a",
      "temperature": 0.2,
      "description": "Escribe y corre tests para un cambio concreto.",
