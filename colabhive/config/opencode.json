      "mode": "primary",
      "tools": {
        "bash": false,
        "webfetch": false,
        "skill": false,
        "todowrite": false
      }
    },
    "seguridad": {
      "mode": "subagent",
      "model": "colabhive/1af07b1f-5832-4451-a61c-76d1fe43115a",
      "temperature": 0.1,
      "description": "Revisa el diff buscando secretos, inyección, permisos y dependencias nuevas. Solo lee.",
      "prompt": "{file:./prompts/seguridad.md}",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      },
      "tools": {
        "webfetch": false,
        "skill": false,
        "task": false,
        "todowrite": false
      }
    },
    "devops": {
      "mode": "subagent",
