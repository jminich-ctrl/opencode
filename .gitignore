PLAN.md.previo

# mediciones en vivo contra la plataforma
colabhive/research/live/
.venv

# dependencias instaladas: las instala el método (scripts/preparar-entorno.sh), no la tarea.
# Sin esto el gate las ve en el diff y pone ROJO por "archivos generados" — un rojo que no
# es del agente, que es exactamente la clase de defecto que más nos costó.
node_modules
.entorno
.mysql

# El material crudo cosechado SÍ se versiona, aunque sean .log: es el producto, no ruido.
# `*.log` de arriba lo excluía entero y lo dejaba fuera del commit en silencio.
!experimentos/crudo/**/*.log

# El banco de TestEval son datos de terceros: lo baja `scripts/bajar_testeval.py` con el
# hash clavado, que es tan reproducible como la copia y deja clara la procedencia.
experimentos/crudo/testeval/
